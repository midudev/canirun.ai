#!/usr/bin/env sh
set -eu

if ! command -v bun >/dev/null 2>&1; then
  echo "runai requires Bun. Install it from https://bun.sh" >&2
  exit 127
fi

SCRIPT_PATH=$0
while [ -L "${SCRIPT_PATH}" ]; do
  LINK_TARGET=$(readlink -- "${SCRIPT_PATH}")
  case "${LINK_TARGET}" in
    /*) SCRIPT_PATH=${LINK_TARGET} ;;
    *) SCRIPT_PATH=$(dirname -- "${SCRIPT_PATH}")/${LINK_TARGET} ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd)
DIST_CLI="${SCRIPT_DIR}/../dist/cli.js"

if [ ! -f "${DIST_CLI}" ]; then
  echo "runai installation is incomplete: dist/cli.js was not found." >&2
  exit 1
fi

exec bun "${DIST_CLI}" "$@"
