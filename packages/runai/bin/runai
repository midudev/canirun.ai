#!/usr/bin/env sh
set -eu

if ! command -v bun >/dev/null 2>&1; then
  echo "runai requires Bun. Install it from https://bun.sh" >&2
  exit 127
fi

# Follow symlinks by hand: the installer links this script into a global bin dir,
# and `readlink -f`/`realpath` are not available on every macOS/Linux setup.
SELF=$0
while [ -L "${SELF}" ]; do
  LINK=$(readlink -- "${SELF}")
  case "${LINK}" in
    /*) SELF=${LINK} ;;
    *) SELF=$(dirname -- "${SELF}")/${LINK} ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${SELF}")" && pwd)
DIST_CLI="${SCRIPT_DIR}/../dist/cli.js"

if [ ! -f "${DIST_CLI}" ]; then
  echo "runai installation is incomplete: dist/cli.js was not found." >&2
  exit 1
fi

exec bun "${DIST_CLI}" "$@"
