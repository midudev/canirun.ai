---
import Layout from "@/layouts/Layout.astro"
import NavHeader from "@/components/NavHeader.astro"
import Footer from "@/components/Footer.astro"
import IconTerminal from "@/icons/terminal.svg"
import IconCopy from "@/icons/copy.svg"

const installCommand = "curl -fsSL https://canirun.ai/runai/install.sh | bash"
---

<Layout
  title="runai — Run local AI models"
  description="Install runai to download and run local AI models with hardware-aware quantization."
>
  <NavHeader />
  <main class="mx-auto flex min-h-[70vh] max-w-3xl items-center px-4 py-16 sm:px-6">
    <article class="w-full">
      <p class="mb-3 inline-flex items-center gap-2 font-mono text-sm text-accent">
        <IconTerminal class="size-4" aria-hidden="true" />
        Local AI, one command away
      </p>
      <h1 class="font-pixel text-3xl tracking-tight text-primary sm:text-5xl">
        Meet runai
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-secondary">
        runai picks a model quantization for your hardware, downloads it, and
        opens a local chat using llama.cpp. No manual GGUF hunting or runtime
        configuration.
      </p>

      <section class="mt-10 rounded-xl border border-accent/30 bg-accent/5 p-4 sm:p-6" aria-labelledby="install-runai">
        <h2 id="install-runai" class="font-pixel text-base text-accent">
          Install on macOS, Linux or WSL
        </h2>
        <div class="mt-4 flex items-center gap-2 rounded-lg border border-edge bg-surface px-3 py-1.5">
          <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-sm text-primary">
            {installCommand}
          </code>
          <button
            id="copy-runai-install"
            type="button"
            class="inline-flex size-11 shrink-0 items-center justify-center rounded text-muted transition-colors hover:bg-accent/10 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            data-command={installCommand}
            aria-label="Copy runai install command"
          >
            <IconCopy class="size-4" aria-hidden="true" />
          </button>
        </div>
        <p id="copy-install-status" class="sr-only" aria-live="polite"></p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Review the stable
          <a
            href="/runai/install.sh"
            class="text-secondary underline decoration-secondary/30 underline-offset-2 hover:text-primary"
          >installer script</a>
          before running it.
        </p>
      </section>

      <section class="mt-10" aria-labelledby="use-runai">
        <h2 id="use-runai" class="font-pixel text-base text-primary">Run a model</h2>
        <p class="mt-3 text-secondary">
          Copy the runai command from any model page, or pass its model ID directly:
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg border border-edge bg-surface-card p-4"><code class="font-mono text-sm text-primary">runai run qwen3.5-4b</code></pre>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLButtonElement>("#copy-runai-install")
    const status = document.querySelector<HTMLElement>("#copy-install-status")
    if (!button || !status) return

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.command || "")
        status.textContent = "Install command copied to clipboard."
        button.setAttribute("aria-label", "Install command copied")
      } catch {
        status.textContent = "Could not copy the install command."
      }
    })
  })
</script>
