---
import Layout from "@/layouts/Layout.astro"
import NavHeader from "@/components/NavHeader.astro"
import { models, getActiveParamsBillions, isCommercialLicense, getLicenseTier, getLineageSuccessor } from "@/data/models"
import { getLicenseSlug } from "@/data/licenses"
import ollamaReadmes from "@/data/ollama-readmes.json"
import { AA_BENCHMARKS, getAaBenchmark } from "@/data/aa-benchmarks"
import IconMoe from "@/icons/moe.svg"
import IconTool from "@/icons/tool.svg"
import IconThinking from "@/icons/thinking.svg"
import IconVision from "@/icons/vision.svg"
import IconVideo from "@/icons/video.svg"
import IconStar from "@/icons/star.svg"
import IconHuggingFace from "@/icons/logo-huggingface.svg"
import IconOllama from "@/icons/logo-ollama.svg"
import IconDownload from "@/icons/download.svg"
import IconCalendar from "@/icons/calendar.svg"
import IconCpu from "@/icons/cpu.svg"
import IconHelp from "@/icons/help.svg"
import IconTerminal from "@/icons/terminal.svg"
import IconCopy from "@/icons/copy.svg"
import IconEdit from "@/icons/edit.svg"
import IconBarChart from "@/icons/bar-chart.svg"
import IconLmStudio from "@/icons/logo-lmstudio.svg"
import IconLicense from "@/icons/license.svg"
import CompanyLogo from "@/components/CompanyLogo.astro"
import { getCompanyByProvider, getCompanyHref } from "@/data/companies"
import { getModelTitleTransitionName } from "@/lib/view-transitions"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import SeoFaq from "@/components/SeoFaq.astro"

export function getStaticPaths() {
  return models.map((model) => ({
    params: { id: model.id },
    props: { model },
  }))
}

const { model } = Astro.props
const ollamaSlug = model.ollamaId?.split(":")[0]
const ollamaHref = ollamaSlug
  ? ollamaSlug.includes("/")
    ? `https://ollama.com/${ollamaSlug}`
    : `https://ollama.com/library/${ollamaSlug}`
  : undefined
const successor = getLineageSuccessor(model, models)
const aa = getAaBenchmark(model.id)
const readme = (ollamaReadmes as Record<string, string>)[model.id] || null
const company = getCompanyByProvider(model.provider)
const companyHref = getCompanyHref(model.provider)
const runaiCommand = `runai run ${model.id}`

const licenseTier = getLicenseTier(model.license)
const licenseColors = licenseTier === "open"
  ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-400"
  : licenseTier === "partial"
    ? "border-amber-400/30 bg-amber-400/10 text-amber-400"
    : "border-orange-400/30 bg-orange-400/10 text-orange-400"
const licenseHint = licenseTier === "open"
  ? `${model.license} — Fully open, commercial use allowed`
  : licenseTier === "partial"
    ? `${model.license} — Commercial with conditions`
    : `${model.license} — Restrictive license`

const q4 = model.quants.find((quant) => quant.name === "Q4_K_M")
const modelFaqs = [
  {
    question: `Can I run ${model.name} locally?`,
    answer: `${model.name} needs about ${model.minRamGB} GB of memory at a minimum and ${model.recommendedRamGB} GB recommended. Open this page to grade it against your GPU or Mac, then run it with runai, Ollama or LM Studio.`,
  },
  {
    question: `How much VRAM does ${model.name} need?`,
    answer: q4
      ? `At Q4_K_M, ${model.name} uses about ${q4.vramGB} GB of VRAM. Higher quants need more memory; lower quants fit tighter cards with a quality tradeoff.`
      : `${model.name} lists ${model.minRamGB} GB minimum and ${model.recommendedRamGB} GB recommended. Check the quantization table on this page for exact sizes.`,
  },
]
---

<Layout
  title={`Can I run ${model.name} locally? VRAM & hardware`}
  description={`${model.name} by ${model.provider}: ${model.minRamGB} GB min, ${model.recommendedRamGB} GB recommended. Check if your GPU or Mac can run it locally.`}
  image={`/og/${model.id}.jpg`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://canirun.ai" },
            { "@type": "ListItem", "position": 2, "name": "Models", "item": "https://canirun.ai/models" },
            ...(company && companyHref
              ? [{ "@type": "ListItem", "position": 3, "name": company.brand, "item": `https://canirun.ai${companyHref}` }]
              : []),
            { "@type": "ListItem", "position": company ? 4 : 3, "name": model.name, "item": `https://canirun.ai/model/${model.id}` }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": model.name,
          "description": model.description,
          "url": `https://canirun.ai/model/${model.id}`,
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Cross-platform",
          "author": { "@type": "Organization", "name": model.provider },
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "memoryRequirements": `${model.recommendedRamGB} GB RAM recommended`,
          "softwareRequirements": `Minimum ${model.minRamGB} GB RAM`
        },
        {
          "@type": "FAQPage",
          "mainEntity": modelFaqs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
          })),
        }
      ]
    })}></script>
  </Fragment>
  <NavHeader />
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Models", href: "/models" },
        ...(company && companyHref
          ? [{ label: company.brand, href: companyHref }]
          : []),
        { label: model.name },
      ]}
    />

    {
      successor && (
        <a
          href={`/model/${successor.id}`}
          class="mb-6 flex items-center justify-between gap-3 rounded-lg border border-accent/30 bg-accent/10 px-4 py-3 font-mono text-[13px] text-accent transition-colors hover:bg-accent/15"
        >
          <span>
            A newer version is available:{" "}
            <span class="text-primary">{successor.name}</span>
          </span>
          <span class="shrink-0 text-accent/80">View →</span>
        </a>
      )
    }

    <!-- Two-column layout -->
    <div class="flex flex-col gap-8 lg:flex-row lg:gap-12">
      <!-- LEFT COLUMN — Model info -->
      <div class="min-w-0 flex-1">
        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3">
            {
              company && (
                <a
                  href={companyHref}
                  aria-label={`View all ${company.name} models`}
                  class="rounded-md transition-transform active:scale-[0.97]"
                >
                  <CompanyLogo company={company} class="size-10" />
                </a>
              )
            }
            <h1
              class="font-pixel text-2xl tracking-tight text-primary sm:text-3xl"
              style={`view-transition-name: ${getModelTitleTransitionName(model.id)};`}
            >
              {model.name}
            </h1>
            {
              model.architecture === "moe" && (
                <span
                  class="rounded border border-info/20 bg-info/10 p-1 text-info h-7 w-7 inline-flex items-center justify-center"
                  title="Mixture of Experts"
                >
                  <IconMoe class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.tools && (
                <span
                  class="rounded border border-purple-400/30 bg-purple-400/10 p-1 text-purple-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Tool Use"
                >
                  <IconTool class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.thinking && (
                <span
                  class="rounded border border-sky-400/30 bg-sky-400/10 p-1 text-sky-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Thinking / Reasoning"
                >
                  <IconThinking class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.useCase.includes("vision") && (
                <span
                  class="rounded border border-rose-400/30 bg-rose-400/10 p-1 text-rose-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Vision"
                >
                  <IconVision class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.useCase.includes("image") && (
                <span
                  class="rounded border border-rose-400/30 bg-rose-400/10 p-1 text-rose-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Image generation"
                >
                  <IconVision class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.useCase.includes("video") && (
                <span
                  class="rounded border border-orange-400/30 bg-orange-400/10 p-1 text-orange-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Video generation"
                >
                  <IconVideo class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.featured && !successor && (
                <span
                  class="rounded border border-yellow-400/30 bg-yellow-400/10 p-1 text-yellow-400 h-7 w-7 inline-flex items-center justify-center"
                  title="Popular"
                >
                  <IconStar class="h-3.5 w-3.5" />
                </span>
              )
            }
            {
              model.license && (
                <a
                  href={`/license/${getLicenseSlug(model.license)}`}
                  class={`inline-flex h-7 items-center gap-1 rounded border px-2 font-mono text-xs transition-opacity hover:opacity-80 ${licenseColors}`}
                  title={licenseHint}
                >
                  <IconLicense class="h-3 w-3" />
                  {model.license}
                </a>
              )
            }
          </div>
          <p class="mt-1 font-mono text-[13px] text-muted">
            {
              companyHref ? (
                <a
                  href={companyHref}
                  class="transition-colors hover:text-accent hover:underline hover:decoration-accent/30 hover:underline-offset-2"
                >
                  {model.provider}
                </a>
              ) : (
                model.provider
              )
            }{" "}
            · {model.params}{
              model.activeParams ? ` (${model.activeParams})` : ""
            } · {model.architecture === "moe" ? "Mixture of Experts" : "Dense"}
          </p>
          <p class="mt-3 text-base leading-relaxed text-secondary">
            {model.description} Check if your GPU or Mac can run {model.name} locally
            — {model.minRamGB} GB min, {model.recommendedRamGB} GB recommended.
          </p>
          <!-- Links -->
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a
              href="/runai"
              class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-3.5 py-1.5 font-mono text-[13px] text-accent transition-colors hover:bg-accent/20"
            >
              <IconTerminal class="h-4 w-4" />
              Run with runai
            </a>
            <a
              href={model.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[#FFD21E]/10 px-3.5 py-1.5 font-mono text-[13px] text-[#FFD21E] transition-colors hover:bg-[#FFD21E]/20"
            >
              <IconHuggingFace class="h-4 w-4" />
              HuggingFace
            </a>
            {
              model.ollamaId && (
                <a
                  href={ollamaHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3.5 py-1.5 font-mono text-[13px] text-primary/80 transition-colors hover:bg-primary/20"
                >
                  <IconOllama class="h-4 w-4" />
                  Ollama
                </a>
              )
            }
            {
              model.lmStudioId && (
                <a
                  href={`https://lmstudio.ai/models/${model.lmStudioId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-[#6C47FF]/10 px-3.5 py-1.5 font-mono text-[13px] text-[#6C47FF] transition-colors hover:bg-[#6C47FF]/20"
                >
                  <IconLmStudio class="h-4 w-4" />
                  LM Studio
                </a>
              )
            }
          </div>
        </header>

        <!-- Stats bar -->
        <div
          class="mb-8 flex flex-wrap items-center gap-4 font-mono text-[13px] text-secondary"
        >
          {
            model.releaseDate && (
              <span class="inline-flex items-center gap-1.5">
                <IconCalendar class="h-3.5 w-3.5 text-muted" />
                {model.releaseDate}
              </span>
            )
          }
          <span class="inline-flex items-center gap-1.5">
            <IconCpu class="h-3.5 w-3.5 text-muted" />
            {
              model.contextLength >= 1024
                ? `${Math.round(model.contextLength / 1024)}K`
                : model.contextLength
            } context
          </span>
        </div>

        <!-- MoE details -->
        {
          model.moe && (
            <section class="mb-8 rounded-lg border border-info/20 bg-info/5 p-4">
              <h2 class="mb-2 font-pixel text-sm text-info">
                Mixture of Experts
              </h2>
              <div class="flex flex-wrap gap-6 font-mono text-[13px] text-secondary">
                <div>
                  <span class="text-muted">Total experts:</span>{" "}
                  <span>{model.moe.numExperts}</span>
                </div>
                <div>
                  <span class="text-muted">Active experts:</span>{" "}
                  <span>{model.moe.activeExperts}</span>
                </div>
                <div>
                  <span class="text-muted">Active params:</span>{" "}
                  <span>
                    {(model.moe.activeParameters / 1_000_000_000).toFixed(1)}B
                  </span>
                </div>
              </div>
            </section>
          )
        }

        <!-- Quantizations table -->
        <section class="mb-8">
          <div class="mb-3 flex items-center gap-2">
            <h2 class="font-pixel text-sm text-muted">Quantization Options</h2>
            <a
              href="/docs#quantization"
              title="What is quantization?"
              class="text-muted transition-colors hover:text-accent"
            >
              <IconHelp class="h-3.5 w-3.5" />
            </a>
          </div>
          <div class="overflow-x-auto rounded-lg border border-edge">
            <table class="w-full text-[13px]">
              <thead>
                <tr
                  class="border-b border-edge bg-surface-card text-left text-xs uppercase tracking-wider text-muted"
                >
                  <th class="px-4 py-2.5">Quant</th>
                  <th class="px-4 py-2.5">Bits</th>
                  <th class="px-4 py-2.5">VRAM</th>
                  <th class="px-4 py-2.5">Quality</th>
                  <th class="px-4 py-2.5">Status</th>
                </tr>
              </thead>
              <tbody>
                {
                  model.quants.map((q: any, i: number) => (
                    <tr
                      data-quant-row
                      data-quant-name={q.name}
                      data-quant-bits={q.bits}
                      data-vram={q.vramGB}
                      class={`border-b border-edge/50 ${i % 2 === 0 ? "bg-surface-card/50" : ""}`}
                    >
                      <td class="px-4 py-2 font-mono text-primary">{q.name}</td>
                      <td class="px-4 py-2 font-mono text-secondary">
                        {q.bits}
                      </td>
                      <td class="px-4 py-2 font-mono text-secondary">
                        {q.vramGB} GB
                      </td>
                      <td class="px-4 py-2 capitalize text-secondary">
                        {q.quality}
                      </td>
                      <td class="px-4 py-2">
                        <span
                          data-quant-status
                          class="font-mono text-xs font-medium uppercase tracking-wider text-muted"
                        >
                          —
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <!-- Ollama README -->
        {readme && (
          <section class="mb-8">
            <h2 class="mb-4 font-pixel text-sm text-muted">About this model</h2>
            <div class="model-readme rounded-lg border border-edge bg-surface-card/30 p-5 sm:p-6" set:html={readme} />
          </section>
        )}
      </div>

      <!-- RIGHT COLUMN — Install & compatibility -->
      <aside class="w-full shrink-0 lg:w-80">
        <!-- Compatibility -->
        <div class="pb-8 mb-8 border-b border-edge/20">
          <h3
            class="mb-3 inline-flex items-center gap-1.5 font-pixel text-sm text-accent"
          >
            <IconCpu class="h-3.5 w-3.5" />
            Your Hardware
          </h3>
          <div
            id="hw-compat"
            class="space-y-2 font-mono text-[13px]"
            data-params={model.paramsBillions}
            data-active-params={getActiveParamsBillions(model)}
          >
            <p class="text-muted italic">Detecting...</p>
          </div>
        </div>

        <!-- Install -->
        <div class="pb-8 mb-8 border-b border-edge/20">
          <h3 class="mb-3 inline-flex items-center gap-1.5 font-pixel text-sm text-accent">
            <IconTerminal class="h-3.5 w-3.5" />
            Run this model
          </h3>
          <div class="rounded-lg border border-accent/30 bg-accent/5 p-3">
            <div class="mb-2 flex items-center justify-between gap-3">
              <a
                href="/runai"
                class="font-pixel text-sm text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent"
              >
                runai
              </a>
              <span class="rounded-full border border-accent/25 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent">
                Recommended
              </span>
            </div>
            <p class="mb-2 text-xs leading-relaxed text-secondary">
              Downloads the best quantization for your hardware and starts a local chat.
            </p>
            <div class="flex items-center gap-2 rounded-md border border-edge bg-surface px-3 py-1.5">
              <code class="min-w-0 flex-1 truncate font-mono text-[13px] text-primary">
                {runaiCommand}
              </code>
              <button
                type="button"
                class="inline-flex size-11 shrink-0 items-center justify-center rounded text-muted transition-colors hover:bg-accent/10 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                data-copy-command={runaiCommand}
                data-copy-status-id="runai-copy-status"
                aria-label={`Copy runai command for ${model.name}`}
              >
                <IconCopy class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>
            <p class="mt-2 font-mono text-[11px] text-muted">
              Recommended quant: <span id="runai-recommended-quant" class="text-primary">detecting…</span>
            </p>
            <p class="mt-3 font-mono text-xs">
              <a class="text-accent underline decoration-accent/30 underline-offset-2 hover:decoration-accent" href="/runai">
                Get runai
              </a>
            </p>
            <p id="runai-copy-status" class="sr-only" aria-live="polite"></p>
          </div>

          <p class="mb-2 mt-5 font-mono text-[11px] uppercase tracking-wider text-muted">
            Other runtimes
          </p>
          {model.ollamaId && (
            <>
              <p class="mb-1 font-mono text-xs text-muted">Ollama</p>
              <div class="flex items-center gap-2 rounded-md border border-edge bg-surface px-3 py-1.5">
                <code class="flex-1 font-mono text-[13px] text-primary truncate">
                  ollama run {model.ollamaId}
                </code>
                <button
                  type="button"
                  class="inline-flex size-11 shrink-0 items-center justify-center rounded text-muted transition-colors hover:bg-yellow-400/10 hover:text-yellow-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
                  data-copy-command={`ollama run ${model.ollamaId}`}
                  data-copy-status-id="ollama-copy-status"
                  aria-label={`Copy Ollama command for ${model.name}`}
                >
                  <IconCopy class="h-4 w-4" aria-hidden="true" />
                </button>
              </div>
              <p id="ollama-copy-status" class="sr-only" aria-live="polite"></p>
            </>
          )}
          {model.lmStudioId && (
            <>
              <p class={`font-mono text-xs text-muted ${model.ollamaId ? "mt-4" : ""} mb-1`}>LM Studio</p>
              <a
                href={`https://lmstudio.ai/models/${model.lmStudioId}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 font-mono text-[13px] text-[#6C47FF] underline decoration-[#6C47FF]/30 underline-offset-2 hover:text-[#8B6CFF]"
              >
                <IconLmStudio class="h-3 w-3 shrink-0" />
                Open in LM Studio
              </a>
            </>
          )}
          <p class={`font-mono text-xs text-muted ${(model.ollamaId || model.lmStudioId) ? "mt-4" : ""} mb-1`}>
            llama.cpp / GGUF
          </p>
          <a
            href={`https://huggingface.co/models?search=${encodeURIComponent(model.name + " GGUF")}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 font-mono text-[13px] text-yellow-400 underline decoration-yellow-400/30 underline-offset-2 hover:text-yellow-300"
          >
            <IconDownload class="h-3 w-3 shrink-0" />
            Download GGUF from HuggingFace
          </a>
        </div>

        <!-- Key specs -->
        <div class="pb-8 mb-8 border-b border-edge/20">
          <h3
            class="mb-3 inline-flex items-center gap-1.5 font-pixel text-sm text-accent"
          >
            <IconEdit class="h-3.5 w-3.5" />
            Specs
          </h3>
          <dl class="space-y-2 font-mono text-[13px]">
            <div class="flex justify-between">
              <dt class="text-muted">Parameters</dt>
              <dd class="text-primary">{model.params}</dd>
            </div>
            {
              model.activeParams && (
                <div class="flex justify-between">
                  <dt class="text-muted">Active</dt>
                  <dd class="text-primary">{model.activeParams}</dd>
                </div>
              )
            }
            <div class="flex justify-between">
              <dt class="text-muted">Architecture</dt>
              <dd class="text-primary">
                {model.architecture === "moe" ? "MoE" : "Dense"}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Tool Use</dt>
              <dd class={model.tools ? "text-purple-400" : "text-muted"}>
                {model.tools ? "Supported" : "No"}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Thinking</dt>
              <dd class={model.thinking ? "text-sky-400" : "text-muted"}>
                {model.thinking ? "Supported" : "No"}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Context</dt>
              <dd class="text-primary">
                {
                  model.contextLength >= 1024
                    ? `${Math.round(model.contextLength / 1024)}K`
                    : model.contextLength
                } tokens
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Min RAM</dt>
              <dd class="text-primary">{model.minRamGB} GB</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Recommended</dt>
              <dd class="text-primary">{model.recommendedRamGB} GB</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted">Family</dt>
              <dd class="text-primary">{model.family}</dd>
            </div>
            {
              model.releaseDate && (
                <div class="flex justify-between">
                  <dt class="text-muted">Released</dt>
                  <dd class="text-primary">{model.releaseDate}</dd>
                </div>
              )
            }
            {
              model.license && (
                <div class="flex justify-between">
                  <dt class="text-muted">License</dt>
                  <dd class={isCommercialLicense(model.license) ? "text-emerald-400" : "text-primary"}>
                    <a href={`/license/${getLicenseSlug(model.license)}`} class="underline decoration-current/30 underline-offset-2 hover:decoration-current">
                      {model.license}
                    </a>
                    {isCommercialLicense(model.license) && (
                      <span class="ml-1 text-[10px] text-emerald-400/70">✓ Commercial</span>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </div>

        {
          aa && (
            <div class="pb-8 mb-8 border-b border-edge/20">
              <h3 class="mb-3 inline-flex items-center gap-1.5 font-pixel text-sm text-accent">
                <IconBarChart class="h-3.5 w-3.5" />
                Benchmarks
              </h3>
              <a
                href={aa.aaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-lg border border-edge bg-surface-card/30 p-4 transition-colors hover:border-accent/40"
              >
                <p class="font-pixel text-3xl leading-none text-primary">
                  {aa.intelligence}
                  {aa.preliminary && (
                    <abbr
                      title="Preliminary score from Artificial Analysis"
                      class="ml-0.5 text-lg text-muted no-underline"
                    >
                      *
                    </abbr>
                  )}
                </p>
                <p class="mt-2 font-mono text-[11px] leading-relaxed text-secondary">
                  Artificial Analysis Intelligence Index {AA_BENCHMARKS.version}
                </p>
                {aa.preliminary && (
                  <p class="mt-1 font-mono text-[11px] text-muted">
                    Preliminary score
                  </p>
                )}
              </a>
              <p class="mt-2 font-mono text-[11px] text-muted">
                Source:{" "}
                <a
                  href="https://artificialanalysis.ai"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-current/30 underline-offset-2 hover:text-primary hover:decoration-current"
                >
                  Artificial Analysis
                </a>
              </p>
              <p class="mt-1 text-[11px] leading-relaxed text-muted">
                Score is for the full / API model. A local quantized GGUF may score lower.
              </p>
            </div>
          )
        }

      </aside>
    </div>
    <SeoFaq title={`Can I run ${model.name} locally?`} faqs={modelFaqs} />
  </main>
</Layout>

<script>
  import {
    detectHardware,
    evaluateModelComplete,
    cleanGPUName,
    getDisplayName,
    getHardwareOverrides,
    saveHardwareOverrides,
    applyOverrides,
    getDeviceOverrides,
    buildSelectOptions,
    RAM_OPTIONS,
    BW_OPTIONS,
    GPU_DB,
    APPLE_DB,
    GRADES,
  } from "@/lib/hardware"
  import type { HardwareInfo, HardwareOverrides } from "@/lib/hardware"
  import { fitSelectWidth, buildGroupedDeviceOptions } from "@/lib/hardware-ui"
  import { DEVICE_CATEGORY_ORDER } from "@/lib/hardware"

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-command]").forEach((copyBtn) => {
      copyBtn.addEventListener("click", async () => {
        const cmd = copyBtn.dataset.copyCommand || ""
        const statusId = copyBtn.dataset.copyStatusId
        const status = statusId ? document.getElementById(statusId) : null
        const originalLabel = copyBtn.getAttribute("aria-label") || "Copy command"
        try {
          await navigator.clipboard.writeText(cmd)
          copyBtn.setAttribute("aria-label", "Command copied")
          if (status) status.textContent = "Command copied to clipboard."
          copyBtn.innerHTML = `<svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
          setTimeout(() => {
            copyBtn.setAttribute("aria-label", originalLabel)
            if (status) status.textContent = ""
            copyBtn.innerHTML = `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`
          }, 2000)
        } catch {
          if (status) status.textContent = "Could not copy the command."
        }
      })
    })

    const container = document.getElementById("hw-compat")!
    if (!container) return

    const paramsBillions = parseFloat(container.dataset.params || "0")
    const activeParamsBillions = parseFloat(container.dataset.activeParams || "0")
    const evaluationOptions = { activeParamsBillions }
    let detectedHW: HardwareInfo
    let currentHW: HardwareInfo

    function buildSelectHTML(id: string, presets: number[], detected: number | null, override: number | undefined, formatter: (v: number) => string): string {
      const options = buildSelectOptions(presets, detected)
      if (override !== undefined && override > 0 && !options.includes(override)) {
        options.push(override)
        options.sort((a, b) => a - b)
      }
      const selectedValue = override ?? detected
      let html = `<select id="${id}" class="hw-editable-select text-primary">`
      for (const v of options) {
        const selected = v === selectedValue ? " selected" : ""
        const label = formatter(v) + (v === detected ? " ✱" : "")
        html += `<option value="${v}"${selected}>${label}</option>`
      }
      html += "</select>"
      return html
    }

    function updateQuantRows(hw: HardwareInfo) {
      const rows = document.querySelectorAll<HTMLElement>("[data-quant-row]")
      rows.forEach((row) => {
        const vram = parseFloat(row.dataset.vram || "0")
        const { toksPerSec, grade } = evaluateModelComplete(vram, hw, paramsBillions, evaluationOptions)
        const info = GRADES[grade]
        const statusEl = row.querySelector("[data-quant-status]") as HTMLElement
        if (statusEl) {
          statusEl.textContent = `${info.label}${toksPerSec ? ` · ~${toksPerSec} t/s` : ""}`
          statusEl.style.color = info.color
        }
      })
    }

    function getRecommendedQuant(hw: HardwareInfo): string | null {
      const candidates = Array.from(document.querySelectorAll<HTMLElement>("[data-quant-row]"))
        .map((row) => ({
          name: row.dataset.quantName || "",
          bits: parseFloat(row.dataset.quantBits || "0"),
          vram: parseFloat(row.dataset.vram || "0"),
        }))
        .filter((quant) => quant.name && quant.vram > 0)
        .sort((a, b) => b.bits - a.bits)

      let comfortable: string | null = null
      let tight: string | null = null
      for (const quant of candidates) {
        const { status } = evaluateModelComplete(quant.vram, hw, paramsBillions)
        if (status === "can-run" && !comfortable) comfortable = quant.name
        if ((status === "tight" || status === "can-run-slow") && !tight) tight = quant.name
      }

      return comfortable ?? tight ?? candidates[candidates.length - 1]?.name ?? null
    }

    function buildDeviceSelectHTML(detectedName: string, storedDevice: string | undefined): string {
      let html = `<select id="hw-device-select" class="hw-editable-select text-primary max-w-[180px]">`
      html += `<option value="auto">${detectedName} ✱</option>`
      html += `<option value="custom"${storedDevice === "custom" ? " selected" : ""}>Custom</option>`

      const grouped = buildGroupedDeviceOptions()
      for (const cat of DEVICE_CATEGORY_ORDER) {
        const items = grouped[cat]
        if (!items?.length) continue
        html += `<optgroup label="${cat}">`
        for (const item of items) {
          const selected = item.value === storedDevice ? " selected" : ""
          html += `<option value="${item.value}"${selected}>${item.label}</option>`
        }
        html += `</optgroup>`
      }
      html += `</select>`
      return html
    }

    function renderSidebar(hw: HardwareInfo) {
      const overrides = getHardwareOverrides()

      const rows = document.querySelectorAll<HTMLElement>("[data-quant-row]")
      let defaultVram = 0
      rows.forEach((row, i) => { if (i === 2) defaultVram = parseFloat(row.dataset.vram || "0") })
      if (defaultVram === 0 && rows.length > 0) {
        defaultVram = parseFloat((rows[0] as HTMLElement).dataset.vram || "0")
      }

      const { grade, toksPerSec: toks } = evaluateModelComplete(defaultVram, hw, paramsBillions, evaluationOptions)
      const info = GRADES[grade]
      const recommendedQuant = getRecommendedQuant(hw)
      const recommendedQuantEl = document.getElementById("runai-recommended-quant")
      if (recommendedQuantEl) {
        recommendedQuantEl.textContent = recommendedQuant ?? "selected automatically"
      }

      const deviceSelect = buildDeviceSelectHTML(getDisplayName(detectedHW), overrides.device)

      const effectiveRam = hw.ramGB ?? hw.totalUsableRAM
      const ramSelect = effectiveRam
        ? buildSelectHTML("hw-ram-select", RAM_OPTIONS, detectedHW.ramGB, overrides.ramGB ?? effectiveRam, (v) => `${v} GB`)
        : `<span class="text-primary">Unknown</span>`

      const effectiveBw = hw.memoryBandwidth
      const bwRow = effectiveBw
        ? `<div class="flex items-center justify-between"><span class="text-muted" data-tooltip="GB/s — How fast data moves to the processor. Higher = faster inference" data-tooltip-pos="bottom" tabindex="0" style="cursor:help">Bandwidth</span>${buildSelectHTML("hw-bw-select", BW_OPTIONS, detectedHW.memoryBandwidth, overrides.memoryBandwidth ?? effectiveBw, (v) => `~${v} GB/s`)}</div>`
        : ""

      let sysramRow = ""
      if (!hw.isMobile) {
        if (hw.isAppleSilicon) {
          sysramRow = `<div class="flex items-center justify-between"><span class="text-muted" data-tooltip="Unified memory — Apple Silicon shares RAM between CPU and GPU. No separate system RAM available for offloading" data-tooltip-pos="bottom" tabindex="0" style="cursor:help">RAM</span><span class="text-primary opacity-50">${hw.totalUsableRAM ?? "—"} GB</span></div>`
        } else {
          const raw = detectedHW.deviceMemoryRaw
          const isGte8 = raw === null || raw >= 8
          const selected = overrides.systemRAM ?? hw.systemRAM ?? 16
          let opts = `<select id="hw-sysram-select" class="hw-editable-select text-primary">`
          opts += `<option value="16"${selected === 16 ? " selected" : ""}>${isGte8 ? "≥8 GB ✱" : "≥8 GB"}</option>`
          opts += `<option value="4"${selected === 4 ? " selected" : ""}>${!isGte8 ? "<8 GB ✱" : "<8 GB"}</option>`
          opts += `<option disabled>───</option>`
          for (const v of [8, 16, 32, 64, 128]) {
            opts += `<option value="${v}"${selected === v ? " selected" : ""}>${v} GB</option>`
          }
          opts += `</select>`
          sysramRow = `<div class="flex items-center justify-between"><span class="text-muted" data-tooltip="System RAM — used for CPU offloading when model doesn't fit in VRAM. More RAM = bigger models via offloading (slower)" data-tooltip-pos="bottom" tabindex="0" style="cursor:help">RAM</span>${opts}</div>`
        }
      }

      container.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="text-muted">Device</span>
          ${deviceSelect}
        </div>
        <div class="flex items-center justify-between">
          <span class="text-muted" data-tooltip="Video memory available for loading models. On Apple Silicon/iGPU, shared with system RAM" data-tooltip-pos="bottom" tabindex="0" style="cursor:help">VRAM</span>
          ${ramSelect}
        </div>
        ${sysramRow}
        ${bwRow}
        <div class="mt-2 flex items-center justify-between border-t border-edge pt-2">
          <span class="text-muted">Q4_K_M</span>
          <span class="inline-flex items-center gap-1.5 font-mono text-xs font-medium uppercase tracking-wider" style="color:${info.color}">
            ${info.label}
            ${toks ? `<span class="text-muted normal-case">· ~${toks} t/s</span>` : ""}
          </span>
        </div>
      `

      const deviceEl = document.getElementById("hw-device-select") as HTMLSelectElement
      const ramEl = document.getElementById("hw-ram-select") as HTMLSelectElement
      const sysramEl = document.getElementById("hw-sysram-select") as HTMLSelectElement
      const bwEl = document.getElementById("hw-bw-select") as HTMLSelectElement

      if (deviceEl) fitSelectWidth(deviceEl)
      if (ramEl) fitSelectWidth(ramEl)
      if (sysramEl) fitSelectWidth(sysramEl)
      if (bwEl) fitSelectWidth(bwEl)

      deviceEl?.addEventListener("change", () => {
        const key = deviceEl.value
        if (key === "auto") {
          saveHardwareOverrides({})
          currentHW = { ...detectedHW }
        } else if (key === "custom") {
          const prev = getHardwareOverrides()
          prev.device = "custom"
          saveHardwareOverrides(prev)
          fitSelectWidth(deviceEl)
          return
        } else {
          const devOverrides = getDeviceOverrides(key)
          if (!devOverrides) return
          saveHardwareOverrides(devOverrides)
          currentHW = applyOverrides(detectedHW, devOverrides)
        }
        updateQuantRows(currentHW)
        renderSidebar(currentHW)
      })

      function handleFieldChange() {
        const newOverrides = getHardwareOverrides()
        if (ramEl?.value) newOverrides.ramGB = Number(ramEl.value)
        if (sysramEl?.value) newOverrides.systemRAM = Number(sysramEl.value)
        if (bwEl?.value) newOverrides.memoryBandwidth = Number(bwEl.value)
        if (!newOverrides.device || newOverrides.device === "auto") {
          newOverrides.device = "custom"
        }
        saveHardwareOverrides(newOverrides)
        currentHW = applyOverrides(detectedHW, newOverrides)
        updateQuantRows(currentHW)
        renderSidebar(currentHW)
      }

      ramEl?.addEventListener("change", handleFieldChange)
      sysramEl?.addEventListener("change", handleFieldChange)
      bwEl?.addEventListener("change", handleFieldChange)
    }

    async function init() {
      detectedHW = await detectHardware()
      currentHW = applyOverrides(detectedHW)
      updateQuantRows(currentHW)
      renderSidebar(currentHW)
    }

    init()
  })
</script>
