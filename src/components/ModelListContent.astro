---
import Footer from "@/components/Footer.astro"
import {
  models,
  getActiveParamsBillions,
  isCommercialLicense,
  getLicenseTier,
  LICENSE_LIST,
  isCurrentInLineage,
  getLineageSuccessor,
} from "@/data/models"
import { getLicenseSlug } from "@/data/licenses"
import hfStats from "@/data/hf-stats.json"
import IconCpu from "@/icons/cpu.svg"
import IconRam from "@/icons/ram.svg"
import IconGpu from "@/icons/gpu.svg"
import IconBandwidth from "@/icons/bandwidth.svg"
import IconSearch from "@/icons/search.svg"
import IconGrid from "@/icons/grid.svg"
import IconGridDots from "@/icons/grid-dots.svg"
import IconList from "@/icons/list.svg"
import IconMoe from "@/icons/moe.svg"
import IconTool from "@/icons/tool.svg"
import IconThinking from "@/icons/thinking.svg"
import IconVision from "@/icons/vision.svg"
import IconVideo from "@/icons/video.svg"
import IconStar from "@/icons/star.svg"
import IconLicense from "@/icons/license.svg"
import IconLock from "@/icons/lock.svg"
import IconUnlock from "@/icons/unlock.svg"
import IconChat from "@/icons/chat.svg"
import IconEdgeDevice from "@/icons/edge-device.svg"
import CompanyLogo from "@/components/CompanyLogo.astro"
import {
  getCompanyByProvider,
  getCompanyHref,
} from "@/data/companies"
import { getModelTitleTransitionName } from "@/lib/view-transitions"
import { AA_BENCHMARKS, getAaBenchmark } from "@/data/aa-benchmarks"
import { USE_CATEGORIES, getModelUseCategories } from "@/lib/use-categories"
import { deviceKeyToSlug } from "@/lib/device-slugs"
import { getDeviceListing } from "@/lib/devices"

// Recommendation categories — the page recommends the best models per use case
// for the detected device instead of dumping the whole catalog.
const REC_CATEGORIES = [
  { key: "text", title: "Can I run coding models?", subtitle: "Chat, code and reasoning", Icon: IconChat },
  { key: "image", title: "Can I run image models?", subtitle: "Generate images locally", Icon: IconVision },
  { key: "video", title: "Can I run video models?", subtitle: "Generate video locally", Icon: IconVideo },
  { key: "small", title: "Can I run tiny models?", subtitle: "On-device, 4B and under", Icon: IconEdgeDevice },
]
const REC_SKELETON_ROWS = [0, 1, 2]

interface Props {
  deviceKey?: string
  mode?: "recs" | "browse"
  useFilter?: string
}

const { deviceKey, mode = "recs", useFilter = "all" } = Astro.props
const recsHref = deviceKey ? `/device/${deviceKeyToSlug(deviceKey)}` : "/"
const lockedDeviceName = deviceKey
  ? getDeviceListing(deviceKey)?.name
  : undefined

const hfStatsTyped = hfStats as Record<
  string,
  { downloads: number; likes: number }
>

const sortedModels = [...models].sort(
  (a, b) => a.paramsBillions - b.paramsBillions,
)
const featuredModels = sortedModels.filter(
  (m) => m.featured && isCurrentInLineage(m, models),
)
const otherModels = sortedModels.filter(
  (m) => !(m.featured && isCurrentInLineage(m, models)),
)

const providers = [...new Set(models.map((m) => m.provider))].sort()

function aaTooltip(preliminary?: boolean): string {
  return `Artificial Analysis Intelligence Index ${AA_BENCHMARKS.version}${preliminary ? " (preliminary)" : ""}. Score is for the full / API model.`
}

function getModelModality(useCase: string[]): {
  label: "Text" | "Image" | "Video"
  Icon: typeof IconChat
} {
  if (useCase.includes("video")) return { label: "Video", Icon: IconVideo }
  if (useCase.includes("image")) return { label: "Image", Icon: IconVision }
  return { label: "Text", Icon: IconChat }
}

function licenseTooltip(license: string): string {
  const tier = getLicenseTier(license)
  if (tier === "open") return `${license} — Fully open, commercial use allowed`
  if (tier === "partial") return `${license} — Commercial with conditions`
  return `${license} — Restrictive license`
}

function licenseIconClass(license: string): string {
  const tier = getLicenseTier(license)
  if (tier === "open") return "text-emerald-400/80"
  if (tier === "partial") return "text-amber-400/80"
  return "text-orange-400/70"
}

function timeAgo(dateStr: string | null): string {
  if (!dateStr) return ""
  const now = new Date()
  const date = new Date(dateStr + "-01")
  const diffMs = now.getTime() - date.getTime()
  const days = Math.floor(diffMs / (1000 * 60 * 60 * 24))
  if (days < 0) return "upcoming"
  if (days === 0) return "today"
  if (days === 1) return "1 day ago"
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return "1 month ago"
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(months / 12)
  if (years === 1) return "1 year ago"
  return `${years}y ago`
}
---

<main
  id="results"
  class="page-shell mx-auto max-w-6xl px-4 pb-20 pt-10 sm:px-6"
  data-device-key={deviceKey}
  data-mode={mode}
  data-use-filter={useFilter}
>
  <!-- Page-specific header -->
  <slot name="header" />

  <!-- Hardware Panel — always 5 slots so detection cannot grow/shrink the row -->
  <section id="hw-panel" class="mb-8" aria-label="Detected hardware" aria-busy="true">
    <div id="hw-bar" class="hw-spec-panel">
      <!-- GPU — locked on device pages; only VRAM is editable there -->
      <span
        id="hw-gpu"
        class:list={["hw-spec", lockedDeviceName ? "text-secondary" : "text-muted"]}
      >
        <span
          data-tooltip={lockedDeviceName
            ? "GPU for this device — change VRAM if your memory configuration differs"
            : "GPU detected via browser APIs — this is an estimate, actual specs may differ"}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label="GPU info"
          class="hw-spec-label"
        >
          <IconGpu class="h-3.5 w-3.5" />
          GPU
        </span>
        {
          lockedDeviceName ? (
            <span id="hw-gpu-name" class="hw-spec-value">
              {lockedDeviceName}
            </span>
          ) : (
            <select id="hw-device-select" class="hw-editable-select" disabled>
              <option value="">detecting...</option>
            </select>
          )
        }
      </span>
      <!-- VRAM -->
      <span id="hw-ram" class="hw-spec text-muted">
        <span
          data-tooltip="VRAM — Video memory available for loading models. On Apple Silicon/iGPUs, it's shared with system RAM"
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label="VRAM info"
          class="hw-spec-label"
        >
          <IconRam class="h-3.5 w-3.5" />
          <span id="hw-vram-label">VRAM</span>
        </span>
        <select id="hw-ram-select" class="hw-editable-select" disabled>
          <option value="">—</option>
        </select>
      </span>
      <!-- Bandwidth -->
      <span id="hw-bw" class="hw-spec text-muted">
        <span
          data-tooltip="GB/s — Memory bandwidth. How fast data moves to the processor. Higher = faster inference"
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label="Bandwidth info"
          class="hw-spec-label"
        >
          <IconBandwidth class="h-3.5 w-3.5" />
          BW
        </span>
        <select id="hw-bw-select" class="hw-editable-select" disabled>
          <option value="">—</option>
        </select>
      </span>
      <!-- System RAM -->
      <span id="hw-sysram" class="hw-spec text-muted">
        <span
          data-tooltip="System RAM — used for CPU offloading when model doesn't fit in VRAM. More RAM = bigger models via offloading (slower)"
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label="System RAM info"
          class="hw-spec-label"
        >
          <IconRam class="h-3.5 w-3.5" />
          RAM
        </span>
        <select id="hw-sysram-select" class="hw-editable-select" disabled>
          <option value="">—</option>
        </select>
      </span>
      <!-- GPU Cores -->
      <span id="hw-gpu-cores" class="hw-spec text-muted">
        <span
          data-tooltip="GPU cores — more cores allow faster parallel computation for model inference"
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label="GPU cores info"
          class="hw-spec-label"
        >
          <IconCpu class="h-3.5 w-3.5" />
          Cores
        </span>
        <span id="hw-gpu-cores-text" class="hw-spec-value">—</span>
      </span>
    </div>
  </section>

  <!-- Summary — one sentence + quiet grade breakdown -->
  <div id="summary-bar" class:list={["mb-9 invisible", { hidden: mode === "recs" }]}>
    <p
      class="text-center text-[15px] leading-relaxed text-secondary"
      aria-live="polite"
    >
      <span id="summary-fit" class="font-medium text-primary">0</span>
      {" "}of{" "}
      <span id="summary-total" class="font-medium text-primary">0</span>
      {" "}models fit comfortably
      <span id="summary-extra" class="text-muted"></span>
    </p>
    <div class="grade-meter mx-auto mt-3 max-w-md" aria-hidden="true">
      <span id="meter-s" class="bg-can-run"></span>
      <span id="meter-a" class="bg-grade-a"></span>
      <span id="meter-b" class="bg-grade-b"></span>
      <span id="meter-c" class="bg-maybe"></span>
      <span id="meter-d" class="bg-grade-d"></span>
      <span id="meter-f" class="bg-cannot-run"></span>
    </div>
    <div
      class="mt-3.5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 font-mono text-[11px] sm:text-xs"
    >
      <span
        data-grade-chip="S"
        class="grade-chip"
        style="color: var(--color-can-run)"
        data-tooltip="Grade S — Plenty of VRAM, fast inference"
        tabindex="0"
        role="group"
        aria-label="Grade S: Runs great"
      >
        <span class="opacity-70">S</span>
        <span id="count-s" class="font-medium tabular-nums">0</span>
      </span>
      <span
        data-grade-chip="A"
        class="grade-chip"
        style="color: var(--color-grade-a)"
        data-tooltip="Grade A — Runs smoothly with good headroom"
        tabindex="0"
        role="group"
        aria-label="Grade A: Runs well"
      >
        <span class="opacity-70">A</span>
        <span id="count-a" class="font-medium tabular-nums">0</span>
      </span>
      <span
        data-grade-chip="B"
        class="grade-chip"
        style="color: var(--color-grade-b)"
        data-tooltip="Grade B — Decent performance, uses most memory"
        tabindex="0"
        role="group"
        aria-label="Grade B: Decent"
      >
        <span class="opacity-70">B</span>
        <span id="count-b" class="font-medium tabular-nums">0</span>
      </span>
      <span
        data-grade-chip="C"
        class="grade-chip"
        style="color: var(--color-maybe)"
        data-tooltip="Grade C — Tight fit, slower inference speeds"
        tabindex="0"
        role="group"
        aria-label="Grade C: Tight fit"
      >
        <span class="opacity-70">C</span>
        <span id="count-c" class="font-medium tabular-nums">0</span>
      </span>
      <span
        data-grade-chip="D"
        class="grade-chip"
        style="color: var(--color-grade-d)"
        data-tooltip="Grade D — Barely fits, very slow inference"
        tabindex="0"
        role="group"
        aria-label="Grade D: Barely runs"
      >
        <span class="opacity-70">D</span>
        <span id="count-d" class="font-medium tabular-nums">0</span>
      </span>
      <span
        data-grade-chip="F"
        class="grade-chip"
        style="color: var(--color-cannot-run)"
        data-tooltip="Grade F — Not enough memory to run this model"
        tabindex="0"
        role="group"
        aria-label="Grade F: Too heavy"
      >
        <span class="opacity-70">F</span>
        <span id="count-f" class="font-medium tabular-nums">0</span>
      </span>
    </div>
  </div>

  <!-- Mode switch — Best picks vs Browse all (own URLs) -->
  <div id="view-mode-tabs" class="mb-8 flex justify-center">
    <nav
      class="inline-flex rounded-full border border-edge/70 bg-surface-card p-1 font-mono text-[13px]"
      aria-label="Catalog view"
    >
      <a
        href={recsHref}
        data-mode-btn="recs"
        aria-current={mode === "recs" ? "page" : undefined}
        class:list={[
          "mode-tab rounded-full px-4 py-1.5 text-muted no-underline",
          { "mode-tab-active": mode === "recs" },
        ]}
      >
        Best picks
      </a>
      <a
        href="/models"
        data-mode-btn="browse"
        aria-current={mode === "browse" ? "page" : undefined}
        class:list={[
          "mode-tab rounded-full px-4 py-1.5 text-muted no-underline",
          { "mode-tab-active": mode === "browse" },
        ]}
      >
        Browse all
      </a>
    </nav>
  </div>

  <!-- Recommendations — skeletons reserve the list height before detection -->
  <section
    id="recommendations"
    class:list={["mb-10", { hidden: mode !== "recs" }]}
    aria-busy={mode === "recs" ? "true" : undefined}
  >
    <p class="rec-device-line mb-7 text-center text-sm text-secondary">
      Top open models for{" "}
      <span id="rec-device-name" class="font-medium text-primary">your device</span>
    </p>
    <div class="grid gap-12">
      {
        REC_CATEGORIES.map((cat) => (
          <div class="rec-group" data-rec-group={cat.key}>
            <div class="rec-head">
              <h3>
                <span class="rec-head-icon" aria-hidden="true">
                  <cat.Icon class="h-4 w-4" />
                </span>
                {cat.title}
              </h3>
              <p>{cat.subtitle}</p>
            </div>
            <div class="rec-list" data-rec-cards>
              {REC_SKELETON_ROWS.map(() => (
                <div class="rec-card rec-skel" aria-hidden="true">
                  <span class="rec-grade"><span class="rec-skel-bar rec-skel-grade" /></span>
                  <span class="rec-name"><span class="rec-skel-bar rec-skel-name" /></span>
                  <span class="rec-provider"><span class="rec-skel-bar rec-skel-sm" /></span>
                  <span class="rec-params"><span class="rec-skel-bar rec-skel-sm" /></span>
                  <span class="rec-vram"><span class="rec-skel-bar rec-skel-sm" /></span>
                  <span class="rec-aa"><span class="rec-skel-bar rec-skel-sm" /></span>
                  <span class="rec-speed"><span class="rec-skel-bar rec-skel-sm" /></span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div id="rec-empty" class="hidden py-14 text-center">
      <p class="font-pixel text-lg text-muted/60">
        This device is very constrained
      </p>
      <p class="mt-2 font-mono text-sm text-muted/50">
        Nothing runs comfortably yet. Switch to <a
          href="/models"
          class="text-accent underline decoration-edge underline-offset-2 hover:text-primary"
          >Browse all</a
        > to see the lightest options.
      </p>
    </div>
  </section>

  <!-- Browse all — full filterable catalog -->
  <div id="browse-section" class:list={[{ hidden: mode !== "browse" }]}>
    <div class="filter-bar">
      <div class="filter-top">
        <label class="filter-search">
          <span class="sr-only">Search models</span>
          <IconSearch class="filter-search-icon" />
          <input
            id="search-input"
            type="search"
            placeholder="Search models..."
            class="filter-search-input"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd>/</kbd>
        </label>

        <button
          id="view-toggle"
          class="filter-view"
          type="button"
          title="Toggle view mode"
        >
          <IconGrid id="view-icon-simple" class="hidden h-4 w-4" />
          <IconGridDots id="view-icon-advanced" class="hidden h-4 w-4" />
          <IconList id="view-icon-list" class="h-4 w-4" />
          <span id="view-label" class="sr-only">List</span>
        </button>
      </div>

      <div class="filter-row">
        <select id="filter-status" class="filter-select">
          <option value="all">Grade</option>
          <option value="featured">Popular</option>
          <option value="can-run">Can run (S/A/B)</option>
          <option value="tight">Tight fit (C/D)</option>
          <option value="cannot-run">Too heavy (F)</option>
        </select>

        <select id="filter-use" class="filter-select">
          <option value="all">Task</option>
          {USE_CATEGORIES.map((cat) => (
            <option value={cat.key}>{cat.label}</option>
          ))}
          <option value="code">Coding</option>
        </select>

        <select id="filter-provider" class="filter-select">
          <option value="all">Lab</option>
          {providers.map((p) => <option value={p}>{p}</option>)}
        </select>

        <select id="filter-license" class="filter-select">
          <option value="all">License</option>
          <option value="commercial">Commercial use</option>
          <option value="non-commercial">Non-commercial</option>
          {LICENSE_LIST.map((l) => <option value={l}>{l}</option>)}
        </select>

        <select
          id="sort-select"
          class="filter-select filter-sort"
          aria-label="Sort models"
        >
          <option value="score">Sort by Score (DESC)</option>
          <option value="aa">Sort by AA (DESC)</option>
          <option value="params-asc">Sort by Params (ASC)</option>
          <option value="params-desc">Sort by Params (DESC)</option>
          <option value="release">Sort by Newest (DESC)</option>
          <option value="context">Sort by Context (DESC)</option>
          <option value="toks">Sort by Speed (DESC)</option>
          <option value="vram">Sort by VRAM (ASC)</option>
          <option value="downloads">Sort by Popularity (DESC)</option>
        </select>
      </div>
    </div>

  <!-- Popular models -->
  <div id="models-grid" class="grid grid-cols-1 list-view">
    {
      featuredModels.map((model) => (
        <a href={`/model/${model.id}`} class="block">
          <article
            data-model-id={model.id}
            data-model-name={model.name}
            data-quants={JSON.stringify(model.quants)}
            data-params={model.paramsBillions}
            data-active-params={getActiveParamsBillions(model)}
            data-arch={model.architecture}
            data-uses={model.useCase.join(",")}
            data-provider={model.provider}
            data-company-slug={getCompanyByProvider(model.provider)?.slug}
            data-context={model.contextLength}
            data-release={model.releaseDate || ""}
            data-thinking={model.thinking ? "true" : "false"}
            data-tools={model.tools ? "true" : "false"}
            data-featured="true"
            data-lineage={model.lineage || ""}
            data-superseded={isCurrentInLineage(model, models) ? "false" : "true"}
            data-successor-id={getLineageSuccessor(model, models)?.id || ""}
            data-license={model.license || ""}
            data-commercial={
              isCommercialLicense(model.license) ? "true" : "false"
            }
            data-downloads={hfStatsTyped[model.id]?.downloads || 0}
            data-aa={getAaBenchmark(model.id)?.intelligence ?? ""}
            class="model-card list-mode group relative flex h-full flex-col rounded-lg border border-edge/60 bg-surface-card transition-colors hover:bg-surface-hover"
          >
            <div data-card-body class="flex flex-col p-4 pb-3">
              <div data-card-top class="min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    {
                      getCompanyByProvider(model.provider) && (
                        <span
                          data-company-link={getCompanyHref(model.provider)}
                          data-company-preview={model.provider}
                          class="cursor-pointer"
                          title={`View all ${model.provider} models`}
                        >
                          <CompanyLogo
                            company={getCompanyByProvider(model.provider)!}
                            class="size-5"
                          />
                        </span>
                      )
                    }
                    <h3
                      class="truncate font-pixel text-base text-primary"
                      style={`view-transition-name: ${getModelTitleTransitionName(model.id)};`}
                    >
                      {model.name}
                    </h3>
                    {model.license && (
                      <span
                        data-license-icon
                        data-license-link={`/license/${getLicenseSlug(model.license)}`}
                        data-tooltip={licenseTooltip(model.license)}
                        tabindex="0"
                        aria-label={licenseTooltip(model.license)}
                        class:list={[
                          "hidden size-6 shrink-0 items-center justify-center cursor-pointer",
                          licenseIconClass(model.license),
                        ]}
                      >
                        {getLicenseTier(model.license) === "open" ? (
                          <IconUnlock class="size-3.5" aria-hidden="true" />
                        ) : (
                          <IconLock class="size-3.5" aria-hidden="true" />
                        )}
                      </span>
                    )}
                    <span
                      data-badges
                      class="inline-flex items-center gap-1 shrink-0"
                    >
                      {model.architecture === "moe" && (
                        <span
                          class="shrink-0 rounded border border-info/20 bg-info/5 p-0.5 text-info h-5 w-5 inline-flex items-center justify-center"
                          title="Mixture of Experts"
                        >
                          <IconMoe class="h-3 w-3" />
                        </span>
                      )}
                      {model.tools && (
                        <span
                          class="shrink-0 rounded border border-purple-400/30 bg-purple-400/10 p-0.5 text-purple-400 h-5 w-5 inline-flex items-center justify-center"
                          title="Tool Use"
                        >
                          <IconTool class="h-3 w-3" />
                        </span>
                      )}
                      {model.thinking && (
                        <span
                          class="shrink-0 rounded border border-sky-400/30 bg-sky-400/10 p-0.5 text-sky-400 h-5 w-5 inline-flex items-center justify-center"
                          title="Thinking / Reasoning"
                        >
                          <IconThinking class="h-3 w-3" />
                        </span>
                      )}
                      {model.useCase.includes("vision") && (
                        <span
                          class="shrink-0 rounded border border-rose-400/30 bg-rose-400/10 p-0.5 text-rose-400 h-5 w-5 inline-flex items-center justify-center"
                          title="Vision"
                        >
                          <IconVision class="h-3 w-3" />
                        </span>
                      )}
                      {model.useCase.includes("image") && (
                        <span
                          class="shrink-0 rounded border border-rose-400/30 bg-rose-400/10 p-0.5 text-rose-400 h-5 w-5 inline-flex items-center justify-center"
                          title="Image generation"
                        >
                          <IconVision class="h-3 w-3" />
                        </span>
                      )}
                      {model.useCase.includes("video") && (
                        <span
                          class="shrink-0 rounded border border-orange-400/30 bg-orange-400/10 p-0.5 text-orange-400 h-5 w-5 inline-flex items-center justify-center"
                          title="Video generation"
                        >
                          <IconVideo class="h-3 w-3" />
                        </span>
                      )}
                      <span
                        class="shrink-0 rounded border border-yellow-400/30 bg-yellow-400/10 p-0.5 text-yellow-400 h-5 w-5 inline-flex items-center justify-center"
                        title="Popular"
                      >
                        <IconStar class="h-3 w-3" />
                      </span>
                      {model.license &&
                        (() => {
                          const tier = getLicenseTier(model.license)
                          const colors =
                            tier === "open"
                              ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-400"
                              : tier === "partial"
                                ? "border-amber-400/30 bg-amber-400/10 text-amber-400"
                                : "border-orange-400/30 bg-orange-400/10 text-orange-400"
                          const hint =
                            tier === "open"
                              ? `${model.license} — Fully open, commercial use allowed`
                              : tier === "partial"
                                ? `${model.license} — Commercial with conditions`
                                : `${model.license} — Restrictive license`
                          return (
                            <span
                              data-license-link={`/license/${getLicenseSlug(model.license)}`}
