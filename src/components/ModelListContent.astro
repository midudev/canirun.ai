    minimax: logoMiniMax,
    microsoft: logoMicrosoft,
    mistral: logoMistral,
    nvidia: logoNvidia,
    openai: logoOpenAI,
    ornith: logoOrnith,
    qwen: logoQwen,
    tencent: logoTencent,
    zai: logoZai,
  }

  const COMPANY_LOGO_INLINE: Record<string, string> = {
    liquid: logoLiquidSvg,
    openai: logoOpenAISvg,
    zai: logoZaiSvg,
    internscience: logoInternScienceSvg,
  }

  function companyLogoMark(company: { logo?: string; name: string }): string {
    const inline = company.logo ? COMPANY_LOGO_INLINE[company.logo] : ""
    const url = company.logo ? COMPANY_LOGOS[company.logo] : ""
    const initials =
      company.name.match(/[A-Z]/g)?.slice(0, 2).join("") ||
      company.name.slice(0, 2).toUpperCase()
    if (inline) {
      return inline.replace(
        /<svg\b/,
        '<svg aria-hidden="true" style="width:62%;height:62%"',
      )
    }
    if (url) return `<img src="${url}" alt="" style="width:62%;height:62%" />`
    return `<span class="font-pixel text-[8px] text-accent">${initials}</span>`
  }

  const $ = <T extends Element = HTMLElement>(s: string) =>
    document.querySelector<T>(s)
  const $$ = <T extends Element = HTMLElement>(s: string) => [
    ...document.querySelectorAll<T>(s),
  ]

  // ── URL / Query Param Helpers ─────────────────────────────

  function buildFilterQueryString(): URLSearchParams {
    const params = new URLSearchParams()
    if (searchQuery) params.set("q", searchQuery)
    if (activeStatusFilter !== "all") params.set("status", activeStatusFilter)
    if (activeUseFilter !== "all") params.set("use", activeUseFilter)
    if (activeProviderFilter !== "all")
      params.set("provider", activeProviderFilter)
    if (activeLicenseFilter !== "all")
      params.set("license", activeLicenseFilter)
    if (showPreviousVersions) params.set("previous", "1")
    if (currentSort !== "score") params.set("sort", currentSort)
    return params
  }

  const FILTERS_SESSION_KEY = "canirun:filters"

  function saveFiltersToSession() {
    try {
      const params = buildFilterQueryString()
      if (params.toString()) {
        sessionStorage.setItem(FILTERS_SESSION_KEY, params.toString())
      } else {
        sessionStorage.removeItem(FILTERS_SESSION_KEY)
      }
    } catch {
      // sessionStorage unavailable (private browsing, quota exceeded)
    }
  }

  function syncFiltersToURL() {
    const params = buildFilterQueryString()
    if (window.location.pathname.startsWith("/models/")) params.delete("use")
    const qs = params.toString() ? `?${params.toString()}` : ""
    const path = window.location.pathname
    history.replaceState({}, "", `${path}${qs}`)
    saveFiltersToSession()
  }

  function readFiltersFromURL() {
    const params = new URLSearchParams(window.location.search)
    const hasUrlFilters =
      params.has("q") ||
      params.has("status") ||
      params.has("use") ||
      params.has("provider") ||
      params.has("license") ||
      params.has("sort")

    const restoredFromSession = !hasUrlFilters
    if (restoredFromSession) {
      try {
        const stored = sessionStorage.getItem(FILTERS_SESSION_KEY)
        if (stored) {
          const storedParams = new URLSearchParams(stored)
          params.set("q", storedParams.get("q") || "")
          params.set("status", storedParams.get("status") || "all")
          params.set("use", storedParams.get("use") || "all")
          params.set("provider", storedParams.get("provider") || "all")
          params.set("license", storedParams.get("license") || "all")
          params.set("sort", storedParams.get("sort") || "")
        }
      } catch {
        // sessionStorage unavailable
      }
    }

    searchQuery = params.get("q") || ""
    activeStatusFilter = params.get("status") || "all"
    activeUseFilter = normalizeUseFilter(params.get("use"))
    activeProviderFilter = params.get("provider") || "all"
    activeLicenseFilter = params.get("license") || "all"
    showPreviousVersions = params.get("previous") === "1"
    const sortParam = params.get("sort")
    if (sortParam) currentSort = sortParam

    const searchInput = $<HTMLInputElement>("#search-input")
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")
    const previousToggle = $<HTMLInputElement>("#filter-previous")
    const sortSelect = $<HTMLSelectElement>("#sort-select")

    if (searchInput) searchInput.value = searchQuery
    if (statusSelect) statusSelect.value = activeStatusFilter
    if (useSelect) useSelect.value = activeUseFilter
    if (providerSelect) providerSelect.value = activeProviderFilter
    if (licenseSelect) licenseSelect.value = activeLicenseFilter
    if (previousToggle) previousToggle.checked = showPreviousVersions
    if (sortSelect) sortSelect.value = currentSort

    if (restoredFromSession) {
      const cleanParams = buildFilterQueryString()
      const qs = cleanParams.toString() ? `?${cleanParams.toString()}` : ""
      history.replaceState({}, "", `${window.location.pathname}${qs}`)
    }
  }

  // ── Main Logic ─────────────────────────────────────────────

  let detectedHW: HardwareInfo
  let currentHW: HardwareInfo
  // Device pages preview a GPU without overwriting the home default.
  let pageOverrides: HardwareOverrides | null = null

  function isDevicePage(): boolean {
    return Boolean(document.getElementById("results")?.dataset.deviceKey)
  }

  function activeOverrides(): HardwareOverrides {
    return pageOverrides ?? getHardwareOverrides()
  }

  function populateDeviceSelect(
    select: HTMLSelectElement,
    detectedName: string,
    storedDevice: string | undefined,
  ) {
    select.innerHTML = ""

    const autoOpt = document.createElement("option")
    autoOpt.value = "auto"
    autoOpt.textContent = `${detectedName} ✱`
    select.appendChild(autoOpt)

    const customOpt = document.createElement("option")
    customOpt.value = "custom"
    customOpt.textContent = "Custom"
    select.appendChild(customOpt)

    appendDeviceOptgroups(select, storedDevice)

    select.value = storedDevice || "auto"
    select.disabled = false
    fitSelectWidth(select)
  }

  function updateHardwarePanel(hw: HardwareInfo) {
    const overrides = activeOverrides()

    const deviceSelect = $<HTMLSelectElement>("#hw-device-select")
    const deviceLocked = isDevicePage()
    if (deviceSelect && !deviceLocked) {
      populateDeviceSelect(
        deviceSelect,
        getDisplayName(detectedHW),
        overrides.device,
      )
    }
    $("#hw-gpu")!.classList.replace("text-muted", "text-secondary")

    const effectiveRam = hw.ramGB ?? hw.totalUsableRAM
    const ramSelect = $<HTMLSelectElement>("#hw-ram-select")
    if (ramSelect && effectiveRam) {
      populateSelect(
        ramSelect,
        RAM_OPTIONS,
        detectedHW.ramGB,
        overrides.ramGB ?? effectiveRam,
        (v) => `${v} GB`,
      )
      ramSelect.disabled = false
    }
    $("#hw-ram")!.classList.replace("text-muted", "text-secondary")

    const vramLabel = $("#hw-vram-label")
    if (vramLabel) vramLabel.textContent = "VRAM"

    const sysramContainer = $("#hw-sysram")
    const sysramSelect = $<HTMLSelectElement>("#hw-sysram-select")
    const sysramTooltip = sysramContainer?.querySelector(
      "[data-tooltip]",
    ) as HTMLElement | null
    if (sysramContainer && sysramSelect) {
      sysramContainer.classList.remove("hidden")
      sysramContainer.classList.replace("text-muted", "text-secondary")
      if (hw.isMobile) {
        sysramSelect.innerHTML = ""
        const opt = document.createElement("option")
        opt.value = ""
        opt.textContent = "—"
        sysramSelect.appendChild(opt)
        sysramSelect.disabled = true
        sysramSelect.classList.add("opacity-50", "cursor-not-allowed")
      } else if (hw.isAppleSilicon) {
        sysramSelect.innerHTML = ""
        const opt = document.createElement("option")
        opt.value = ""
        opt.textContent = `${hw.totalUsableRAM ?? "—"} GB`
        sysramSelect.appendChild(opt)
        sysramSelect.disabled = true
        sysramSelect.classList.add("opacity-50", "cursor-not-allowed")
        fitSelectWidth(sysramSelect)
        if (sysramTooltip) {
          sysramTooltip.setAttribute(
            "data-tooltip",
            "Unified memory — Apple Silicon shares RAM between CPU and GPU. No separate system RAM available for offloading",
          )
        }
      } else {
        sysramSelect.disabled = false
        sysramSelect.classList.remove("opacity-50", "cursor-not-allowed")
        const raw = detectedHW.deviceMemoryRaw
        const isGte8 = raw === null || raw >= 8
        const selected = overrides.systemRAM ?? hw.systemRAM ?? 16

        sysramSelect.innerHTML = ""
        const optGte8 = document.createElement("option")
        optGte8.value = "16"
        optGte8.textContent = isGte8 ? "≥8 GB ✱" : "≥8 GB"
        sysramSelect.appendChild(optGte8)

        const optLt8 = document.createElement("option")
        optLt8.value = "4"
        optLt8.textContent = !isGte8 ? "<8 GB ✱" : "<8 GB"
        sysramSelect.appendChild(optLt8)

        const sep = document.createElement("option")
        sep.disabled = true
        sep.textContent = "───"
        sysramSelect.appendChild(sep)

        for (const v of [8, 16, 32, 64, 128]) {
          const opt = document.createElement("option")
          opt.value = String(v)
          opt.textContent = `${v} GB`
          sysramSelect.appendChild(opt)
        }

        sysramSelect.value = String(selected)
        fitSelectWidth(sysramSelect)
        if (sysramTooltip) {
          sysramTooltip.setAttribute(
            "data-tooltip",
            "System RAM — used for CPU offloading when model doesn't fit in VRAM. More RAM = bigger models via offloading (slower)",
          )
        }
      }
    }

    const effectiveBw = hw.memoryBandwidth
    const bwSelect = $<HTMLSelectElement>("#hw-bw-select")
    const bwEl = $("#hw-bw")
    bwEl?.classList.remove("hidden")
    if (effectiveBw && bwSelect) {
      bwEl?.classList.replace("text-muted", "text-secondary")
      populateSelect(
        bwSelect,
        BW_OPTIONS,
        detectedHW.memoryBandwidth,
        overrides.memoryBandwidth ?? effectiveBw,
        (v) => `~${v} GB/s`,
      )
    } else if (bwSelect) {
      bwSelect.innerHTML = ""
      const opt = document.createElement("option")
      opt.value = ""
      opt.textContent = "—"
      bwSelect.appendChild(opt)
      bwSelect.disabled = true
    }

    const coresEl = $("#hw-gpu-cores")
    const coresText = $("#hw-gpu-cores-text")
    coresEl?.classList.remove("hidden")
    if (hw.gpuCores && coresText) {
      coresEl?.classList.replace("text-muted", "text-secondary")
      coresText.textContent = `${hw.gpuCores.toLocaleString()}`
    } else if (coresText) {
      coresText.textContent = "—"
    }

    $("#hw-panel")?.setAttribute("aria-busy", "false")

    const webgpuStatus = $("#hw-webgpu-status")
    if (webgpuStatus) {
      webgpuStatus.textContent = hw.webgpu
        ? "WebGPU available"
        : "WebGPU not available"
    }
  }

  function handleDeviceChange(deviceKey: string) {
    if (deviceKey === "custom") {
      const prev = getHardwareOverrides()
      prev.device = "custom"
      saveHardwareOverrides(prev)
      return
    }

    const params = buildFilterQueryString()
    const qs = params.toString() ? `?${params.toString()}` : ""

    if (deviceKey === "auto") {
      saveHardwareOverrides({})
      currentHW = { ...detectedHW }
      updateHardwarePanel(currentHW)
      updateAllCards(currentHW)
      history.pushState(
        {},
        "",
        `${isBrowsePath() ? window.location.pathname : "/"}${qs}`,
      )
      return
    }

    const deviceOverrides = getDeviceOverrides(deviceKey)
    if (!deviceOverrides) return

    const prev = getHardwareOverrides()
    if (prev.systemRAM !== undefined) deviceOverrides.systemRAM = prev.systemRAM

    saveHardwareOverrides(deviceOverrides)
    currentHW = applyOverrides(detectedHW, deviceOverrides)
    updateHardwarePanel(currentHW)
    updateAllCards(currentHW)

    const slug = deviceKeyToSlug(deviceKey)
    history.pushState(
      {},
      "",
      isBrowsePath()
        ? `${window.location.pathname}${qs}`
        : `/device/${slug}${qs}`,
    )
  }

  function setupHardwareEditing() {
    const deviceSelect = $<HTMLSelectElement>("#hw-device-select")
    const ramSelect = $<HTMLSelectElement>("#hw-ram-select")
    const sysramSelect = $<HTMLSelectElement>("#hw-sysram-select")
    const bwSelect = $<HTMLSelectElement>("#hw-bw-select")

    deviceSelect?.addEventListener("change", () => {
      handleDeviceChange(deviceSelect.value)
    })

    function handleFieldChange() {
      const overrides = { ...activeOverrides() }
      const lockedKey = document.getElementById("results")?.dataset.deviceKey
      if (ramSelect?.value) overrides.ramGB = Number(ramSelect.value)
      if (sysramSelect?.value) overrides.systemRAM = Number(sysramSelect.value)
      if (bwSelect?.value) overrides.memoryBandwidth = Number(bwSelect.value)
      if (!overrides.device || overrides.device === "auto") {
        if (lockedKey) {
          overrides.device = lockedKey
        } else {
          overrides.device = "custom"
          const ds = $<HTMLSelectElement>("#hw-device-select")
          if (ds) {
            ds.value = "custom"
            fitSelectWidth(ds)
          }
        }
      }
      if (isDevicePage()) {
        pageOverrides = overrides
      } else {
        saveHardwareOverrides(overrides)
      }
      currentHW = applyOverrides(detectedHW, overrides)
      if (currentHW.isAppleSilicon && sysramSelect) {
        const opt = sysramSelect.options[0]
        if (opt) opt.textContent = `${currentHW.totalUsableRAM ?? "—"} GB`
        fitSelectWidth(sysramSelect)
      }
      updateAllCards(currentHW)
    }

    ramSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(ramSelect)
    })
    sysramSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(sysramSelect)
    })
    bwSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(bwSelect)
    })
  }

  function updateModelCard(
    card: HTMLElement,
    hw: HardwareInfo,
    quantIndex: number = 0,
  ) {
    const quants = JSON.parse(card.dataset.quants || "[]")
    const quant = quants[quantIndex] || quants[0]
    if (!quant) return

    const vram = quant.vramGB
    const params = parseFloat(card.dataset.params || "0")
    const activeParams = parseFloat(card.dataset.activeParams || "0")
    const {
      status,
      toksPerSec: toks,
      memPct,
      score,
      grade,
    } = evaluateModelComplete(vram, hw, params, {
      activeParamsBillions: activeParams,
    })
    const gradeInfo = GRADES[grade]

    const label = card.querySelector<HTMLElement>("[data-status-label]")
    if (label) {
      label.textContent = gradeInfo.label
      label.style.color = gradeInfo.color
    }

    const scoreNumEl = card.querySelector<HTMLElement>("[data-score-num]")
    if (scoreNumEl) {
      const den = document.createElement("span")
      den.dataset.scoreDen = ""
      den.textContent = "/100"
      scoreNumEl.replaceChildren(document.createTextNode(String(score)), den)
      scoreNumEl.style.color = gradeInfo.color
    }

    card.dataset.grade = grade

    const memPill = card.querySelector<HTMLElement>("[data-mem-pct-pill]")
    if (memPill) {
      if (memPct !== null) {
        memPill.classList.remove("hidden")
        if (status === "can-run-slow") {
          memPill.textContent = `${memPct}% ↗ RAM`
          memPill.className =
            "rounded-full bg-offload/15 px-1.5 py-px text-[11px] font-medium text-offload"
        } else if (memPct > 100) {
          memPill.textContent = `${memPct}%`
          memPill.className =
            "rounded-full bg-cannot-run/15 px-1.5 py-px text-[11px] font-medium text-cannot-run"
        } else if (memPct > 75) {
          memPill.textContent = `${memPct}%`
          memPill.className =
            "rounded-full bg-maybe/15 px-1.5 py-px text-[11px] font-medium text-maybe"
        } else {
          memPill.textContent = `${memPct}%`
          memPill.className =
            "rounded-full bg-can-run/15 px-1.5 py-px text-[11px] font-medium text-can-run"
        }
      }
    }

    const memMeter = card.querySelector<HTMLElement>("[data-mem-meter]")
    const memFill = card.querySelector<HTMLElement>("[data-mem-meter-fill]")
    const vramEl = card.querySelector<HTMLElement>("[data-vram]")
    if (memMeter && memFill) {
      if (memPct !== null) {
        memMeter.hidden = false
        const level =
          status === "can-run-slow"
            ? "offload"
            : memPct > 100
              ? "over"
              : memPct > 75
                ? "tight"
                : "ok"
        const hint =
          status === "can-run-slow"
            ? `${memPct}% of VRAM — overflow to system RAM`
            : memPct > 100
              ? `${memPct}% of VRAM — does not fit`
              : `${memPct}% of VRAM`
        memMeter.dataset.level = level
        memMeter.style.setProperty(
          "--mem-fill",
          String(Math.min(memPct, 100) / 100),
        )
        memMeter.setAttribute("aria-valuenow", String(Math.min(memPct, 100)))
        memMeter.setAttribute("aria-label", hint)
        if (vramEl) {
          vramEl.dataset.tooltip = hint
          vramEl.tabIndex = 0
        }
      } else {
        memMeter.hidden = true
        if (vramEl) {
          delete vramEl.dataset.tooltip
          vramEl.removeAttribute("tabindex")
        }
      }
    }
    const memDetail = card.querySelector<HTMLElement>("[data-mem-pct-detail]")
    if (memDetail) {
      if (memPct !== null) {
        if (status === "can-run-slow") {
          memDetail.textContent = `${memPct}% ↗ RAM`
          memDetail.style.color = "var(--color-offload)"
        } else {
          memDetail.textContent = `${memPct}%`
          if (memPct > 100) memDetail.style.color = "var(--color-cannot-run)"
          else if (memPct > 75) memDetail.style.color = "var(--color-maybe)"
          else memDetail.style.color = "var(--color-can-run)"
        }
      } else {
        memDetail.textContent = "—"
      }
    }

    const tokEl = card.querySelector<HTMLElement>("[data-tok-speed]")
    if (tokEl) {
      const shown = toks !== null && status !== "cannot-run" ? toks : 0
      tokEl.textContent = `~${shown} tok/s`

      if (toks !== null && status !== "cannot-run") {
        tokEl.dataset.tok = String(toks)
        tokEl.tabIndex = 0
        tokEl.setAttribute(
          "aria-label",
          `Approximately ${toks} tokens per second. Hover or focus to preview the perceived generation speed`,
        )
        if (toks >= 60) tokEl.className = "font-mono text-[13px] text-can-run"
        else if (toks >= 30)
          tokEl.className = "font-mono text-[13px] text-can-run/70"
        else if (toks >= 15)
          tokEl.className = "font-mono text-[13px] text-maybe"
        else if (toks >= 5)
          tokEl.className = "font-mono text-[13px] text-maybe/70"
        else tokEl.className = "font-mono text-[13px] text-cannot-run"
      } else {
        delete tokEl.dataset.tok
        tokEl.removeAttribute("tabindex")
        tokEl.removeAttribute("aria-label")
        tokEl.className = "font-mono text-[13px] text-cannot-run/70"
      }
    }

    const quantBtns = card.querySelectorAll<HTMLElement>("[data-quant-btn]")
    quantBtns.forEach((btn, i) => {
      if (i === quantIndex) {
        btn.className =
          "quant-btn rounded px-1.5 py-0.5 text-xs font-mono transition-colors border border-accent/30 bg-accent/10 text-accent"
      } else {
        btn.className =
          "quant-btn rounded px-1.5 py-0.5 text-xs font-mono transition-colors border border-transparent text-muted hover:text-secondary"
      }
    })

    const vramVal = card.querySelector<HTMLElement>("[data-vram-val]")
    if (vramVal) vramVal.textContent = Number(vram).toFixed(1)

    card.dataset.status = status
    card.dataset.score = String(score)
    card.dataset.selectedQuant = String(quantIndex)
  }

  function updateAllCards(hw: HardwareInfo) {
    $$("[data-model-id]").forEach((card) => {
      const qi = parseInt(card.dataset.selectedQuant || "2")
      updateModelCard(card, hw, qi)
    })
    updateSummary()
    sortAndAnimateCards()
    if (recMode === "recs") buildRecommendations()
  }

  function updateSummary() {
    const counts: Record<string, number> = {
      S: 0,
      A: 0,
      B: 0,
      C: 0,
      D: 0,
      F: 0,
    }
    $$("[data-model-id]").forEach((c) => {
      const g = c.dataset.grade || "?"
      if (g in counts) counts[g]++
    })
    const total = Object.values(counts).reduce((sum, n) => sum + n, 0)
    const fit = counts.S + counts.A + counts.B
    const tight = counts.C + counts.D
    for (const [grade, count] of Object.entries(counts)) {
      const key = grade.toLowerCase()
      $("#count-" + key)!.textContent = String(count)
      $(`[data-grade-chip="${grade}"]`)?.classList.toggle("is-zero", count === 0)
      const meter = $("#meter-" + key)
      if (meter) meter.style.width = total ? `${(count / total) * 100}%` : "0%"
    }
    const fitEl = $("#summary-fit")
    const totalEl = $("#summary-total")
    const extraEl = $("#summary-extra")
    if (fitEl) fitEl.textContent = String(fit)
    if (totalEl) totalEl.textContent = String(total)
    if (extraEl) {
      const parts: string[] = []
      if (tight) parts.push(`${tight} tight`)
      if (counts.F) parts.push(`${counts.F} too heavy`)
      extraEl.textContent = parts.length ? ` · ${parts.join(" · ")}` : ""
    }
    const bar = $("#summary-bar")
    if (bar) {
      bar.classList.toggle("hidden", recMode === "recs")
      if (recMode !== "recs") bar.classList.remove("invisible")
    }
  }

  let currentSort = "score"

  function sortAndAnimateCards() {
    const order: Record<string, number> = {
      "can-run": 0,
      tight: 1,
      "can-run-slow": 2,
      unknown: 3,
      "cannot-run": 4,
    }

    function sortComparator(a: HTMLElement, b: HTMLElement): number {
      const cardA = a.querySelector<HTMLElement>("[data-model-id]")!
      const cardB = b.querySelector<HTMLElement>("[data-model-id]")!

      switch (currentSort) {
        case "aa": {
          const aaA = Number.parseInt(cardA.dataset.aa || "", 10)
          const aaB = Number.parseInt(cardB.dataset.aa || "", 10)
          const nA = Number.isFinite(aaA) ? aaA : -1
          const nB = Number.isFinite(aaB) ? aaB : -1
          if (nA !== nB) return nB - nA
          return (
            parseFloat(cardA.dataset.params || "0") -
            parseFloat(cardB.dataset.params || "0")
          )
        }
        case "params-asc":
          return (
            parseFloat(cardA.dataset.params || "0") -
            parseFloat(cardB.dataset.params || "0")
          )
        case "params-desc":
          return (
            parseFloat(cardB.dataset.params || "0") -
            parseFloat(cardA.dataset.params || "0")
          )
        case "release": {
          const ra = cardA.dataset.release || ""
          const rb = cardB.dataset.release || ""
          return rb.localeCompare(ra)
        }
        case "context":
          return (
            parseInt(cardB.dataset.context || "0") -
            parseInt(cardA.dataset.context || "0")
          )
        case "toks": {
          const tokA =
            cardA.querySelector<HTMLElement>("[data-tok-speed]")?.textContent ||
            ""
          const tokB =
            cardB.querySelector<HTMLElement>("[data-tok-speed]")?.textContent ||
            ""
          const tA = parseInt(tokA.replace(/[^0-9]/g, "")) || 0
          const tB = parseInt(tokB.replace(/[^0-9]/g, "")) || 0
          return tB - tA
        }
        case "vram": {
          const qA = JSON.parse(cardA.dataset.quants || "[]")
          const qB = JSON.parse(cardB.dataset.quants || "[]")
          const vA =
            qA[parseInt(cardA.dataset.selectedQuant || "2")]?.vramGB || 0
          const vB =
            qB[parseInt(cardB.dataset.selectedQuant || "2")]?.vramGB || 0
          return vA - vB
        }
        case "downloads": {
          const dA = parseInt(cardA.dataset.downloads || "0")
          const dB = parseInt(cardB.dataset.downloads || "0")
          return dB - dA
        }
        default: {
          const sa = order[cardA.dataset.status || "unknown"] ?? 2
          const sb = order[cardB.dataset.status || "unknown"] ?? 2
          if (sa !== sb) return sa - sb
          const scoreA = parseInt(cardA.dataset.score || "0")
          const scoreB = parseInt(cardB.dataset.score || "0")
          if (scoreA !== scoreB) return scoreB - scoreA
          return (
            parseFloat(cardA.dataset.params || "0") -
            parseFloat(cardB.dataset.params || "0")
          )
        }
      }
    }

    let animIdx = 0
    for (const gridId of ["#models-grid", "#models-grid-rest"]) {
      const grid = $(gridId)
      if (!grid) continue
      const links = Array.from(grid.children) as HTMLElement[]
      links.sort(sortComparator)
      links.forEach((link) => {
        const card = link.querySelector<HTMLElement>("[data-model-id]")
        if (card) {
          card.style.animationDelay = `${animIdx * 25}ms`
          card.classList.add("fade-in")
        }
        grid.appendChild(link)
        animIdx++
      })
    }
  }

  // ── Recommendations ────────────────────────────────────────
  //
  // Instead of listing every model, we surface the best picks per use case
  // for the detected device. Ranking is quality-first (editorial pick order,
  // model capability, recency, popularity) but gated by whether the model
  // actually runs comfortably — so we never recommend something too heavy.

  const REC_CAT_KEYS = ["text", "image", "video", "small"] as const
  type RecCat = (typeof REC_CAT_KEYS)[number]

  // Curated top-of-class open models per category (best first), refreshed from
  // current mid-2026 recommendations. Only IDs present in the catalog are used.
  const EDITORIAL: Record<RecCat, string[]> = {
    text: [
      "qwen3.6-35b-a3b", "qwen3.8-27b", "minimax-m3", "kimi-k3", "agents-a1", "longcat-2.0",
      "gemma4-26b-a4b-it", "gpt-oss-20b", "gemma4-31b-it", "mistral-small-4-119b", "hy3",
      "glm-4.5-air", "qwen3-32b", "devstral-small-2-24b", "glm-5.3", "glm-5.2", "qwen3-coder-480b",
      "deepseek-r1-14b", "phi-4-14b", "qwen3-14b", "qwen3-8b", "qwen3.5-9b",
      "qwen2.5-coder-7b", "deepseek-r1-32b",
    ],
    image: [
      "flux2-dev", "qwen-image-2512", "hunyuan-image-3-instruct", "z-image-turbo",
      "flux2-klein-9b", "flux2-klein-4b", "hunyuan-image-3",
    ],
    video: [
      "minimax-h3", "ltx-2.3", "wan2.2-t2v-a14b", "hunyuan-video-1.5",
      "wan2.2-ti2v-5b", "wan2.1-t2v-1.3b",
    ],
    small: [
      "ministral-3-3b", "qwen3.5-4b", "gemma3-4b", "qwen3.5-2b", "smollm3-3b",
      "phi-4-mini-reasoning", "qwen3-1.7b", "llama3.2-3b", "gemma3-1b",
      "qwen3.5-0.8b", "qwen3-0.6b", "llama3.2-1b",
    ],
  }

  interface RecModel {
    id: string
    name: string
    href: string
    uses: string[]
    params: number
    provider: string
    arch: string
    release: string
    downloads: number
    featured: boolean
    thinking: boolean
    tools: boolean
    vision: boolean
    grade: string
    status: string
    score: number
    toks: number
    vram: string
    aa: number | null
  }

  function collectRecModels(): RecModel[] {
    return $$("#models-grid > a, #models-grid-rest > a")
      .map((link): RecModel | null => {
        const c = link.querySelector<HTMLElement>("[data-model-id]")
        if (!c) return null
        if (c.dataset.superseded === "true") return null
        const tokEl = c.querySelector<HTMLElement>("[data-tok-speed]")
        const uses = (c.dataset.uses || "").split(",").filter(Boolean)
        return {
          id: c.dataset.modelId || "",
          name: c.dataset.modelName || "",
          href: link.getAttribute("href") || "#",
          uses,
          params: parseFloat(c.dataset.params || "0"),
          provider: c.dataset.provider || "",
          arch: c.dataset.arch || "dense",
          release: c.dataset.release || "",
          downloads: parseInt(c.dataset.downloads || "0"),
          featured: c.dataset.featured === "true",
          thinking: c.dataset.thinking === "true",
          tools: c.dataset.tools === "true",
          vision: uses.includes("vision"),
          grade: c.dataset.grade || "?",
          status: c.dataset.status || "unknown",
          score: parseInt(c.dataset.score || "0"),
          toks: tokEl?.dataset.tok ? parseInt(tokEl.dataset.tok) : 0,
          vram: c.querySelector("[data-vram-val]")?.textContent?.trim() || "",
          aa: c.dataset.aa ? parseInt(c.dataset.aa) : null,
        }
      })
      .filter((m): m is RecModel => m !== null)
  }

  function monthsSince(release: string): number {
    if (!release) return 48
    const [y, m] = release.split("-").map(Number)
    if (!y) return 48
    const now = new Date()
    return (now.getFullYear() - y) * 12 + (now.getMonth() + 1 - (m || 1))
  }

  function qualityScore(m: RecModel, cat: RecCat): number {
    const idx = EDITORIAL[cat].indexOf(m.id)
    const editorial = idx === -1 ? 0 : Math.max(6, 30 - idx * 3)
    const params = Math.min(20, Math.log2(m.params + 1) * 3.2)
    const recency = Math.max(0, 15 - monthsSince(m.release) * 0.4)
    const pop = Math.max(0, Math.min(10, (Math.log10(m.downloads + 1) - 3) * 3))
    const feat = m.featured ? 8 : 0
    return editorial + params + recency + pop + feat
  }

  function recScore(
    m: RecModel,
    cat: RecCat,
    usage: Record<string, number>,
  ): number {
    const fitFactor = m.status === "can-run" ? 1 : 0.6
    const speedFactor =
      m.toks >= 30 ? 1 : m.toks >= 15 ? 0.9 : m.toks >= 8 ? 0.78 : m.toks >= 4 ? 0.6 : 0.45
    const reusePenalty = (usage[m.id] || 0) * 10
    return qualityScore(m, cat) * fitFactor * speedFactor + m.score * 0.15 - reusePenalty
  }

  function tokClass(t: number): string {
    if (t >= 60) return "text-can-run"
    if (t >= 30) return "text-can-run/70"
    if (t >= 15) return "text-maybe"
    if (t >= 5) return "text-maybe/70"
    return "text-cannot-run"
  }

  function recCardHTML(m: RecModel): string {
    const gi = GRADES[m.grade as Grade] || GRADES["?"]
    const toksLabel = m.toks > 0 ? `~${m.toks} tok/s` : "slow"
    const company = resolveCompany(m.provider)
    const companyHref = resolveCompanyHref(m.provider)
    const companyLogoHTML =
      company
        ? `<span ${companyHref ? `data-company-link="${companyHref}"` : ""} data-company-preview="${m.provider}" class="rec-logo">${companyLogoMark(company)}</span>`
        : ""
    const vram = m.vram ? `${m.vram} GB` : ""
    const aa = m.aa != null ? `${m.aa} AA` : ""
    return `<a href="${m.href}" class="rec-card">
      <span class="rec-grade" style="color:${gi.color}">${gi.letter}</span>
      <span class="rec-name">${companyLogoHTML}<span class="rec-name-text">${m.name}</span></span>
      <span class="rec-provider"><span ${companyHref ? `data-company-link="${companyHref}"` : ""}>${m.provider}</span></span>
      <span class="rec-params">${m.params}B</span>
      <span class="rec-vram">${vram}</span>
      <span class="rec-aa">${aa}</span>
      <span
        class="rec-speed ${tokClass(m.toks)}"
        ${m.toks > 0 ? `data-tok-speed data-tok="${m.toks}" tabindex="0" aria-label="${toksLabel}. Hover or focus to preview the perceived generation speed"` : ""}
      >${toksLabel}</span>
    </a>`
  }

  function buildRecommendations() {
    // Keep SSR skeletons in place until hardware is known — hiding groups
    // here would collapse the page and cause a layout jump.
    if (!currentHW) return

    const cards = collectRecModels()
    const usage: Record<string, number> = {}

    for (const key of REC_CAT_KEYS) {
      const pool = cards.filter((m) => {
        if (m.status !== "can-run" && m.status !== "tight") return false
        return matchesUseCategory(m.uses, m.params, key)
      })
      pool.sort((a, b) => recScore(b, key, usage) - recScore(a, key, usage))
      const picks = pool.slice(0, 3)

      const group = $(`[data-rec-group="${key}"]`)
      const container = group?.querySelector<HTMLElement>("[data-rec-cards]")
      if (!group || !container) continue

      group.classList.remove("hidden")
      if (picks.length === 0) {
        container.innerHTML = `<p class="rec-none">No models fit this device</p>`
        continue
      }
      container.innerHTML = picks.map(recCardHTML).join("")
      picks.forEach((p) => {
        usage[p.id] = (usage[p.id] || 0) + 1
      })
    }

    const empty = $("#rec-empty")
    if (empty) empty.classList.add("hidden")
    $("#recommendations")?.setAttribute("aria-busy", "false")

    const nameEl = $("#rec-device-name")
    if (nameEl && currentHW) {
      // Follow the device chosen in the hardware panel so the header matches
      // any manual override; fall back to the auto-detected name.
      const sel = $<HTMLSelectElement>("#hw-device-select")
      const val = sel?.value
      nameEl.textContent =
        sel && val && val !== "auto" && val !== "custom"
          ? sel.options[sel.selectedIndex]?.text || getDisplayName(currentHW)
          : getDisplayName(currentHW)
    }
  }

  // ── Mode: Best picks vs Browse all ─────────────────────────

  type RecMode = "recs" | "browse"
  let recMode: RecMode = "recs"

  function isBrowsePath() {
    const path = window.location.pathname
    return path === "/models" || path.startsWith("/models/")
  }

  function applyRecMode() {
    const recs = $("#recommendations")
    const browse = $("#browse-section")
    const isRecs = recMode === "recs"
    recs?.classList.toggle("hidden", !isRecs)
    browse?.classList.toggle("hidden", isRecs)
    $$("[data-mode-btn]").forEach((btn) => {
      btn.classList.toggle("mode-tab-active", btn.dataset.modeBtn === recMode)
    })
    $("#summary-bar")?.classList.toggle("hidden", isRecs)
    if (isRecs && currentHW) buildRecommendations()
  }

  // ── Filters ────────────────────────────────────────────────

  let activeStatusFilter = "all"
  let activeUseFilter = "all"
  let activeProviderFilter = "all"
  let activeLicenseFilter = "all"
  let showPreviousVersions = false
  let searchQuery = ""

  function applyFilters() {
    const query = searchQuery.toLowerCase()
    let featuredVisible = 0
    let restVisible = 0

    $$("#models-grid > a, #models-grid-rest > a").forEach((link) => {
      const card = link.querySelector<HTMLElement>("[data-model-id]")
      if (!card) return
      const grade = card.dataset.grade || "?"
      const uses = (card.dataset.uses || "").split(",").filter(Boolean)
      const provider = card.dataset.provider || ""
      const name = (card.dataset.modelName || "").toLowerCase()
      const isFeatured = card.dataset.featured === "true"
      const license = card.dataset.license || ""
      const isCommercial = card.dataset.commercial === "true"
      let show = true

      if (query && !name.includes(query)) show = false
      if (
        !showPreviousVersions &&
        !query &&
        card.dataset.superseded === "true"
      )
        show = false
      if (activeStatusFilter === "featured") {
        if (!isFeatured) show = false
      } else if (activeStatusFilter === "can-run") {
        if (!["S", "A", "B"].includes(grade)) show = false
      } else if (activeStatusFilter === "tight") {
        if (!["C", "D"].includes(grade)) show = false
      } else if (activeStatusFilter === "cannot-run") {
        if (grade !== "F") show = false
      }
      if (
        activeUseFilter !== "all" &&
        !matchesUseCategory(uses, parseFloat(card.dataset.params || "0"), activeUseFilter)
      )
        show = false
      if (activeProviderFilter !== "all" && provider !== activeProviderFilter)
        show = false
      if (activeLicenseFilter === "commercial" && !isCommercial) show = false
      else if (activeLicenseFilter === "non-commercial" && isCommercial)
        show = false
      else if (
        activeLicenseFilter !== "all" &&
        activeLicenseFilter !== "commercial" &&
        activeLicenseFilter !== "non-commercial" &&
        license !== activeLicenseFilter
      )
        show = false

      link.style.display = show ? "" : "none"
      if (show) {
        if (isFeatured) featuredVisible++
        else restVisible++
      }
    })

    const totalVisible = featuredVisible + restVisible
    const divider = $("#rest-divider")
    const featuredGrid = $("#models-grid")
    const restGrid = $("#models-grid-rest")
    const noResults = $("#no-results")

    if (divider)
      divider.style.display =
        featuredVisible === 0 || restVisible === 0 ? "none" : ""
    if (featuredGrid)
      featuredGrid.style.display = featuredVisible === 0 ? "none" : ""
    if (restGrid) restGrid.style.display = restVisible === 0 ? "none" : ""
    if (noResults) noResults.style.display = totalVisible === 0 ? "" : "none"
    noResults?.classList.toggle("hidden", totalVisible > 0)
  }

  function resetAllFilters() {
    const searchInput = $<HTMLInputElement>("#search-input")
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")
    const previousToggle = $<HTMLInputElement>("#filter-previous")

    searchQuery = ""
    activeStatusFilter = "all"
    activeUseFilter = "all"
    activeProviderFilter = "all"
    activeLicenseFilter = "all"
    showPreviousVersions = false

    if (searchInput) searchInput.value = ""
    if (statusSelect) statusSelect.value = "all"
    if (useSelect) useSelect.value = "all"
    if (providerSelect) providerSelect.value = "all"
    if (licenseSelect) licenseSelect.value = "all"
    if (previousToggle) previousToggle.checked = false

    if (window.location.pathname.startsWith("/models/")) {
      window.location.assign("/models")
      return
    }

    try {
      sessionStorage.removeItem(FILTERS_SESSION_KEY)
    } catch {
      // sessionStorage unavailable
    }
    applyFilters()
    syncFiltersToURL()
  }

  function setupFilters() {
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")
    const previousToggle = $<HTMLInputElement>("#filter-previous")
    const resetBtn = $("#reset-filters")

    statusSelect?.addEventListener("change", () => {
      activeStatusFilter = statusSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    useSelect?.addEventListener("change", () => {
      const next = useSelect.value
      if (isBrowsePath()) {
        const params = buildFilterQueryString()
        params.delete("use")
        const qs = params.toString() ? `?${params.toString()}` : ""
        window.location.assign(`${getCategoryPath(next)}${qs}`)
        return
      }
      activeUseFilter = next
      applyFilters()
      syncFiltersToURL()
    })

    providerSelect?.addEventListener("change", () => {
      activeProviderFilter = providerSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    licenseSelect?.addEventListener("change", () => {
      activeLicenseFilter = licenseSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    previousToggle?.addEventListener("change", () => {
      showPreviousVersions = previousToggle.checked
      applyFilters()
      syncFiltersToURL()
    })

    resetBtn?.addEventListener("click", resetAllFilters)
  }

  // ── Quant Switching ────────────────────────────────────────

  function setupQuantButtons() {
    $$("[data-quant-btn]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault()
        e.stopPropagation()
        const card = btn.closest<HTMLElement>("[data-model-id]")
        if (!card || !currentHW) return
        const qi = parseInt(btn.dataset.quantBtn || "0")
        updateModelCard(card, currentHW, qi)
      })
    })
  }

  function setupLicenseLinks() {
    document.addEventListener("click", (e) => {
      const badge = (e.target as Element).closest<HTMLElement>(
        "[data-license-link]",
      )
      if (!badge) return
      e.preventDefault()
      e.stopPropagation()
      window.location.href = badge.dataset.licenseLink!
    })
  }

  function setupCompanyLinks() {
    document.addEventListener("click", (e) => {
      const companyLink = (e.target as Element).closest<HTMLElement>(
        "[data-company-link]",
      )
      if (!companyLink?.dataset.companyLink) return
      e.preventDefault()
      e.stopPropagation()
      window.location.href = companyLink.dataset.companyLink
    })
  }

  let companyPreviewWired = false

  function setupCompanyPreview() {
    if (companyPreviewWired) return
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return
    companyPreviewWired = true

    let popup: HTMLElement | null = null
    let activeTrigger: HTMLElement | null = null

    function ensurePopup() {
      if (popup) return
      popup = document.createElement("div")
      popup.className = "company-preview"
      popup.setAttribute("role", "tooltip")
      popup.innerHTML = `
        <div class="company-preview-top">
          <span class="company-preview-logo"></span>
          <span class="company-preview-heading">
            <strong class="company-preview-name"></strong>
            <span class="company-preview-brand"></span>
          </span>
          <span class="company-preview-count"></span>
        </div>
        <p class="company-preview-description"></p>
        <span class="company-preview-link">View all models <span aria-hidden="true">→</span></span>
      `
      document.body.appendChild(popup)
    }

    function position(trigger: HTMLElement) {
      if (!popup) return
      const margin = 10
      const rect = trigger.getBoundingClientRect()
      popup.style.left = "0px"
      popup.style.top = "0px"
      const popupRect = popup.getBoundingClientRect()
      let left = rect.left + rect.width / 2 - popupRect.width / 2
      left = Math.max(
        margin,
        Math.min(left, window.innerWidth - popupRect.width - margin),
      )
      let top = rect.top - popupRect.height - margin
      popup.classList.toggle("company-preview-bottom", top < margin)
      if (top < margin) top = rect.bottom + margin
      popup.style.left = `${left}px`
      popup.style.top = `${top}px`
    }

    function show(trigger: HTMLElement) {
      if (activeTrigger === trigger) return
      const provider = trigger.dataset.companyPreview
      if (!provider) return
      const company = resolveCompany(provider)
      if (!company) return

      ensurePopup()
      if (!popup) return
      activeTrigger = trigger

      const count = document.querySelectorAll(
        `[data-company-slug="${company.slug}"]`,
      ).length
      const name = popup.querySelector<HTMLElement>(".company-preview-name")
      const brand = popup.querySelector<HTMLElement>(".company-preview-brand")
      const countEl = popup.querySelector<HTMLElement>(".company-preview-count")
      const description = popup.querySelector<HTMLElement>(
        ".company-preview-description",
      )
      const logo = popup.querySelector<HTMLElement>(".company-preview-logo")

      if (name) name.textContent = company.name
      if (brand) brand.textContent = company.brand
      if (countEl)
        countEl.textContent = `${count} ${count === 1 ? "model" : "models"}`
      if (description) description.textContent = company.description
      if (logo) {
        logo.innerHTML = companyLogoMark(company)
      }

      popup.classList.add("visible")
      position(trigger)
      requestAnimationFrame(() => {
        if (activeTrigger === trigger) position(trigger)
      })
    }

    function hide() {
      activeTrigger = null
      popup?.classList.remove("visible")
    }

    document.addEventListener("mouseover", (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>(
        "[data-company-preview]",
      )
      if (trigger) show(trigger)
    })

    document.addEventListener("mouseout", (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>(
        "[data-company-preview]",
      )
      if (!trigger) return
      const related = event.relatedTarget as Element | null
      if (!trigger.contains(related)) hide()
    })

    window.addEventListener("scroll", hide, { passive: true })
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hide()
    })
  }

  // ── Init ───────────────────────────────────────────────────

  async function init() {
    detectedHW = await detectHardware()

    const main = document.getElementById("results")
    const urlDeviceKey = main?.dataset.deviceKey

    if (urlDeviceKey) {
      const deviceOverrides = getDeviceOverrides(urlDeviceKey)
      if (deviceOverrides) {
        const prev = getHardwareOverrides()
        if (prev.systemRAM !== undefined)
          deviceOverrides.systemRAM = prev.systemRAM
        pageOverrides = deviceOverrides
      }
    }

    currentHW = applyOverrides(detectedHW, pageOverrides ?? undefined)
    updateHardwarePanel(currentHW)
    updateAllCards(currentHW)
    applyFilters()
  }

  // ── Search ───────────────────────────────────────────────

  function setupSearch() {
    const input = $<HTMLInputElement>("#search-input")
    if (!input) return

    input.addEventListener("input", () => {
      searchQuery = input.value.trim()
      applyFilters()
      syncFiltersToURL()
    })

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "/" &&
        document.activeElement !== input &&
        !(document.activeElement instanceof HTMLInputElement) &&
        !(document.activeElement instanceof HTMLTextAreaElement) &&
        !(document.activeElement instanceof HTMLSelectElement)
      ) {
        e.preventDefault()
        input.focus()
      }
      if (e.key === "Escape" && document.activeElement === input) {
        input.blur()
      }
    })
  }

  // ── Sort ─────────────────────────────────────────────────

  function setupSort() {
    const select = $<HTMLSelectElement>("#sort-select")
    if (!select) return
    select.addEventListener("change", () => {
      currentSort = select.value
      sortAndAnimateCards()
      syncFiltersToURL()
    })
  }

  // ── View Mode Toggle ────────────────────────────────────

  type ViewMode = "simple" | "advanced" | "list"
  let viewMode: ViewMode = "list"

  function applyViewMode() {
    const grids = [$("#models-grid"), $("#models-grid-rest")]
    const iconSimple = $("#view-icon-simple")
    const iconAdvanced = $("#view-icon-advanced")
    const iconList = $("#view-icon-list")
    const label = $("#view-label")

    $$("[data-advanced]").forEach((el) => {
      el.classList.toggle("hidden", viewMode !== "advanced")
    })

    grids.forEach((grid) => {
      if (!grid) return
      if (viewMode === "list") {
        grid.classList.remove("sm:grid-cols-2", "lg:grid-cols-3", "gap-3")
        grid.classList.add("grid-cols-1", "list-view")
      } else {
        grid.classList.remove("grid-cols-1", "list-view")
        grid.classList.add("sm:grid-cols-2", "lg:grid-cols-3", "gap-3")
      }
    })
    $$(".model-card").forEach((card) => {
      card.classList.toggle("list-mode", viewMode === "list")
    })

    if (iconSimple) iconSimple.classList.toggle("hidden", viewMode !== "simple")
    if (iconAdvanced)
      iconAdvanced.classList.toggle("hidden", viewMode !== "advanced")
    if (iconList) iconList.classList.toggle("hidden", viewMode !== "list")
    if (label) {
      const labels: Record<ViewMode, string> = {
        simple: "Simple",
        advanced: "Advanced",
        list: "List",
      }
      label.textContent = labels[viewMode]
    }
  }

  function setupViewToggle() {
    const btn = $("#view-toggle")
    if (!btn) return

    const modes: ViewMode[] = ["simple", "advanced", "list"]

    btn.addEventListener("click", () => {
      const idx = modes.indexOf(viewMode)
      viewMode = modes[(idx + 1) % modes.length]
      localStorage.setItem("viewMode", viewMode)
      applyViewMode()
    })
  }

  // ── Keyboard Navigation ─────────────────────────────────

  function setupKeyboardNav() {
    let focusedCardIndex = -1

    function getVisibleLinks(): HTMLElement[] {
      return $$("#models-grid > a, #models-grid-rest > a").filter(
        (link) => link.style.display !== "none",
      )
    }

    function focusCard(index: number) {
      const links = getVisibleLinks()
      if (index < 0 || index >= links.length) return
      focusedCardIndex = index
      links.forEach((link, i) => {
        const card = link.querySelector<HTMLElement>("[data-model-id]")
        if (card) {
          if (i === index) {
            card.classList.add("ring-1", "ring-accent/40")
            link.scrollIntoView({ block: "nearest", behavior: "smooth" })
          } else {
            card.classList.remove("ring-1", "ring-accent/40")
          }
        }
      })
    }

    function clearFocus() {
      focusedCardIndex = -1
      $$("[data-model-id]").forEach((card) => {
        card.classList.remove("ring-1", "ring-accent/40")
      })
    }

    document.addEventListener("keydown", (e) => {
      const active = document.activeElement
      if (
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement ||
        active instanceof HTMLSelectElement
      )
        return

      const links = getVisibleLinks()

      switch (e.key) {
        case "j":
          e.preventDefault()
          focusCard(Math.min(focusedCardIndex + 1, links.length - 1))
          break
        case "k":
          e.preventDefault()
          focusCard(Math.max(focusedCardIndex - 1, 0))
          break
        case "Enter":
          if (focusedCardIndex >= 0 && focusedCardIndex < links.length) {
            e.preventDefault()
            const link = links[focusedCardIndex] as HTMLAnchorElement
            if (link.href) window.location.href = link.href
          }
          break
        case "Escape":
          clearFocus()
          break
        case "v":
          e.preventDefault()
          $("#view-toggle")?.click()
          break
      }
    })
  }

  // ── Popstate (back/forward navigation) ─────────────────

  function setupPopstate() {
    window.addEventListener("popstate", () => {
      if (!$("#models-grid")) return

      readFiltersFromURL()
      applyFilters()

      const path = window.location.pathname
      const deviceMatch = path.match(/^\/device\/([^/]+)/)
      if (deviceMatch) {
        const key = slugToDeviceKey(deviceMatch[1])
        if (key && detectedHW) {
          const deviceOverrides = getDeviceOverrides(key)
          if (deviceOverrides) {
            const prev = getHardwareOverrides()
            if (prev.systemRAM !== undefined)
              deviceOverrides.systemRAM = prev.systemRAM
            pageOverrides = deviceOverrides
            currentHW = applyOverrides(detectedHW, deviceOverrides)
            updateHardwarePanel(currentHW)
            updateAllCards(currentHW)
          }
        }
      } else if (path === "/" && detectedHW) {
        pageOverrides = null
        currentHW = applyOverrides(detectedHW)
        updateHardwarePanel(currentHW)
        updateAllCards(currentHW)
      }
    })
  }

  // ── Tok/s Hover Preview ────────────────────────────────

  let speedPreviewWired = false

  function setupSpeedPreview() {
    if (speedPreviewWired) return
    if (typeof window === "undefined") return
    speedPreviewWired = true

    // Chat-shaped skeleton: each bar is one token. Lines stay short so a
    // fast model floods the bubble and a slow one crawls across the first line.
    const SKELETON_LINES = [
      [4.8, 2.2, 3.6, 1.6, 5.2, 2.8, 3.1, 2.0, 4.0],
      [3.4, 1.8, 4.6, 2.4, 1.5, 3.9, 2.7, 5.0, 1.7, 3.2],
      [2.6, 4.2, 1.6, 3.5, 2.3, 4.8, 1.9, 3.0, 2.8, 3.7],
      [3.8, 2.1, 4.4, 1.7, 2.9, 3.3, 4.1, 1.8],
      [4.0, 2.4, 3.2, 1.6, 5.0],
    ]
    const SELECTOR = "[data-tok-speed][data-tok]"
    const SHOW_DELAY_MS = 180
    const INSTANT_WINDOW_MS = 380
    const REPLAY_PAUSE_MS = 900

    const canHover = window.matchMedia("(hover: hover)").matches
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches

    let popup: HTMLElement | null = null
    let msgEl: HTMLElement | null = null
    let caretEl: HTMLElement | null = null
    let wordEls: HTMLElement[] = []
    let rateEl: HTMLElement | null = null
    let tierEl: HTMLElement | null = null
    let metaEl: HTMLElement | null = null
    let rafId: number | null = null
    let replayTimeoutId: number | null = null
    let showTimeoutId: number | null = null
    let activeTrigger: HTMLElement | null = null
    let lastVisible = -1
    let lastHiddenAt = -Infinity

    function tierFor(t: number): { label: string; color: string } {
      if (t >= 60) return { label: "Instant", color: "var(--color-can-run)" }
      if (t >= 30) return { label: "Smooth", color: "var(--color-can-run)" }
      if (t >= 15) return { label: "Comfortable", color: "var(--color-maybe)" }
      if (t >= 5) return { label: "Slow", color: "var(--color-maybe)" }
      return { label: "Painful", color: "var(--color-cannot-run)" }
    }

    function formatSeconds(seconds: number): string {
      if (seconds < 10) return `${seconds.toFixed(1)}s`
      return `${Math.round(seconds)}s`
    }

    function wordMarkup(width: number): string {
      return `<span class="speed-preview-word" style="width:${width}ch"></span>`
    }

    function ensurePopup() {
      if (popup?.isConnected) return
      popup = document.createElement("div")
      popup.className = "speed-preview"
      popup.id = "speed-preview-tooltip"
      popup.setAttribute("role", "tooltip")
      const lines = SKELETON_LINES.map(
        (line) =>
          `<div class="speed-preview-line">${line.map(wordMarkup).join("")}</div>`,
      ).join("")
      popup.innerHTML = `
        <div class="speed-preview-head">
          <span class="speed-preview-rate"></span>
          <span class="speed-preview-tier"></span>
        </div>
        <div class="speed-preview-msg" aria-hidden="true">
          ${lines}
          <span class="speed-preview-caret" hidden></span>
        </div>
        <div class="speed-preview-meta"></div>
      `
      document.body.appendChild(popup)
      msgEl = popup.querySelector(".speed-preview-msg")
      caretEl = popup.querySelector(".speed-preview-caret")
      wordEls = Array.from(popup.querySelectorAll(".speed-preview-word"))
      rateEl = popup.querySelector(".speed-preview-rate")
      tierEl = popup.querySelector(".speed-preview-tier")
      metaEl = popup.querySelector(".speed-preview-meta")
    }

    function position(trigger: HTMLElement) {
      if (!popup) return
      const margin = 10
      const rect = trigger.getBoundingClientRect()
      popup.style.left = "0px"
      popup.style.top = "0px"
      const popRect = popup.getBoundingClientRect()
      let left = rect.left + rect.width / 2 - popRect.width / 2
      left = Math.max(
        margin,
        Math.min(left, window.innerWidth - popRect.width - margin),
      )
      let top = rect.top - popRect.height - margin
      const below = top < margin
      if (below) top = rect.bottom + margin
      popup.dataset.placement = below ? "bottom" : "top"
      popup.style.left = `${left}px`
      popup.style.top = `${top}px`
    }

    function placeCaret(visible: number) {
      if (!caretEl || !msgEl || wordEls.length === 0) return
      const total = wordEls.length
      if (visible >= total) {
        caretEl.hidden = true
        return
      }
      const atStart = visible <= 0
      const anchor = atStart ? wordEls[0] : wordEls[visible - 1]
      const msgRect = msgEl.getBoundingClientRect()
      const wordRect = anchor.getBoundingClientRect()
      const x = atStart
        ? wordRect.left - msgRect.left - 3
        : wordRect.right - msgRect.left + 3
      const y = wordRect.top - msgRect.top + (wordRect.height - 11) / 2
      caretEl.hidden = false
      caretEl.style.transform = `translate3d(${x}px, ${y}px, 0)`
    }

    function paintWords(visible: number) {
      const total = wordEls.length
      for (let i = 0; i < total; i++) {
        wordEls[i].classList.toggle("is-on", i < visible)
      }
      placeCaret(visible)
      lastVisible = visible
    }

    function resetWords() {
      lastVisible = -1
      paintWords(0)
    }

    function setMeta(visible: number, elapsedSec: number) {
      if (!metaEl) return
      metaEl.textContent = `${visible} tokens · ${formatSeconds(elapsedSec)}`
    }

    function stopAnimation() {
      if (rafId) {
        cancelAnimationFrame(rafId)
        rafId = null
      }
      if (replayTimeoutId !== null) {
        window.clearTimeout(replayTimeoutId)
        replayTimeoutId = null
      }
    }

    function startAnimation(trigger: HTMLElement, tok: number) {
      stopAnimation()
      resetWords()
      if (!metaEl) return

      const total = wordEls.length
      const wordsPerSec = Math.max(0.5, tok)

      if (reduceMotion) {
        paintWords(total)
        setMeta(total, total / wordsPerSec)
        return
      }

      setMeta(0, 0)
      const start = performance.now()
      const animate = (now: number) => {
        if (activeTrigger !== trigger) return
        const elapsed = now - start
        const visible = Math.min(
          total,
          Math.floor((elapsed / 1000) * wordsPerSec),
        )
        if (visible !== lastVisible) {
          paintWords(visible)
          setMeta(visible, elapsed / 1000)
        }
        if (visible < total) {
          rafId = requestAnimationFrame(animate)
          return
        }
        rafId = null
        setMeta(total, total / wordsPerSec)
        replayTimeoutId = window.setTimeout(() => {
          replayTimeoutId = null
          if (activeTrigger === trigger) startAnimation(trigger, tok)
        }, REPLAY_PAUSE_MS)
      }
      rafId = requestAnimationFrame(animate)
    }

    function reveal(trigger: HTMLElement) {
      const tok = parseFloat(trigger.dataset.tok || "")
      if (!Number.isFinite(tok) || tok <= 0) return
      if (activeTrigger === trigger && popup?.classList.contains("visible")) {
        return
      }

      activeTrigger = trigger
      ensurePopup()
      if (!popup || !msgEl || !rateEl || !tierEl || !metaEl) return
      trigger.setAttribute("aria-describedby", popup.id)

      const t = tierFor(tok)
      const instant = performance.now() - lastHiddenAt < INSTANT_WINDOW_MS
      popup.toggleAttribute("data-instant", instant)
      rateEl.textContent = `≈ ${tok} tok/s`
      rateEl.style.color = t.color
      tierEl.textContent = t.label
      tierEl.style.color = t.color
      msgEl.style.setProperty("--speed-accent", t.color)

      popup.classList.add("visible")
      position(trigger)
      requestAnimationFrame(() => {
        if (activeTrigger === trigger) position(trigger)
      })

      startAnimation(trigger, tok)
    }

    function scheduleShow(trigger: HTMLElement) {
      if (showTimeoutId !== null) {
        window.clearTimeout(showTimeoutId)
        showTimeoutId = null
      }
      const delay =
        performance.now() - lastHiddenAt < INSTANT_WINDOW_MS ? 0 : SHOW_DELAY_MS
      if (delay === 0) {
        reveal(trigger)
        return
      }
      showTimeoutId = window.setTimeout(() => {
        showTimeoutId = null
        reveal(trigger)
      }, delay)
    }

    function hide() {
      if (showTimeoutId !== null) {
        window.clearTimeout(showTimeoutId)
        showTimeoutId = null
      }
      stopAnimation()
      if (activeTrigger) lastHiddenAt = performance.now()
      activeTrigger = null
      document
        .querySelectorAll('[aria-describedby="speed-preview-tooltip"]')
        .forEach((trigger) => trigger.removeAttribute("aria-describedby"))
      if (popup) {
        popup.classList.remove("visible")
        popup.removeAttribute("data-instant")
      }
    }

    function triggerFrom(target: EventTarget | null): HTMLElement | null {
      return (target as Element | null)?.closest<HTMLElement>(SELECTOR) ?? null
    }

    if (canHover) {
      document.addEventListener("mouseover", (e) => {
        const trigger = triggerFrom(e.target)
        if (trigger) scheduleShow(trigger)
      })

      document.addEventListener("mouseout", (e) => {
        const trigger = triggerFrom(e.target)
        if (!trigger) return
        const related = e.relatedTarget as Node | null
        if (!trigger.contains(related)) hide()
      })
    }

    document.addEventListener("focusin", (e) => {
      const trigger = triggerFrom(e.target)
      if (trigger) reveal(trigger)
    })

    document.addEventListener("focusout", (e) => {
      const trigger = triggerFrom(e.target)
      if (!trigger) return
      const next = e.relatedTarget as Node | null
      if (!trigger.contains(next)) hide()
    })

    window.addEventListener("scroll", () => hide(), { passive: true })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hide()
    })
    document.addEventListener("astro:before-swap", () => {
      hide()
      popup?.remove()
      popup = null
    })
  }

  // ── Boot ───────────────────────────────────────────────

  document.addEventListener("astro:page-load", () => {
    if (!$("#models-grid")) return

    activeStatusFilter = "all"
    activeUseFilter = "all"
    activeProviderFilter = "all"
    activeLicenseFilter = "all"
    showPreviousVersions = false
    searchQuery = ""
    currentSort = "score"
    viewMode = (localStorage.getItem("viewMode") as ViewMode) || "list"
    const resultsEl = document.getElementById("results")
    const pageMode = resultsEl?.dataset.mode
    recMode = pageMode === "browse" ? "browse" : "recs"
    const pageUse = resultsEl?.dataset.useFilter
    if (pageUse && pageUse !== "all") activeUseFilter = pageUse

    const params = new URLSearchParams(window.location.search)
    const path = window.location.pathname
    const useParam = normalizeUseFilter(params.get("use"))
    if (
      useParam !== "all" &&
      (path === "/" || path === "/models")
    ) {
      params.delete("use")
      const qs = params.toString() ? `?${params.toString()}` : ""
      window.location.replace(`${getCategoryPath(useParam)}${qs}`)
      return
    }

    // Old /?q= bookmarks used to flip the homepage into Browse all.
    if (path === "/" && window.location.search) {
      const filterKeys = [
        "q",
        "status",
        "provider",
        "license",
        "previous",
        "sort",
      ]
      if (filterKeys.some((key) => params.has(key))) {
        window.location.replace(`/models${window.location.search}`)
        return
      }
    }

    readFiltersFromURL()
    if (pageUse && pageUse !== "all") {
      activeUseFilter = pageUse
      const useSelect = $<HTMLSelectElement>("#filter-use")
      if (useSelect) useSelect.value = pageUse
    }

    setupQuantButtons()
    setupFilters()
    setupSearch()
    setupSort()
    setupViewToggle()
    setupKeyboardNav()
    setupHardwareEditing()
    setupLicenseLinks()
    setupCompanyLinks()
    setupCompanyPreview()
    setupPopstate()
    setupSpeedPreview()
    applyViewMode()
    applyFilters()
    applyRecMode()
    init()
  })
</script>

