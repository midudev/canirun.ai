{
  "name": "canirun-ai",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm packages:build && astro dev",
    "build": "pnpm packages:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "scrape": "tsx scripts/scrape-models.ts",
    "fetch:readmes": "tsx scripts/fetch-ollama-readmes.ts",
    "packages:build": "pnpm --filter @canirun/compatibility --filter @canirun/models build",
    "packages:typecheck": "pnpm --filter @canirun/compatibility --filter @canirun/models typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.6",
    "@canirun/compatibility": "workspace:*",
    "@canirun/models": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "@libsql/client": "0.17.4",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@zumer/snapdom": "2.24.3",
    "astro": "7.2.3",
    "comlink": "4.4.2",
    "pdfjs-dist": "6.2.108",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.72",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}