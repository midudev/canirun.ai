{
  "name": "canirun-ai",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm packages:build && astro dev",
    "build": "pnpm packages:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "scrape": "tsx scripts/scrape-models.ts",
    "fetch:readmes": "tsx scripts/fetch-ollama-readmes.ts",
    "packages:build": "pnpm --filter @canirun/compatibility --filter @canirun/models build",
    "packages:typecheck": "pnpm --filter @canirun/compatibility --filter @canirun/models typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.15",
    "@canirun/compatibility": "workspace:*",
    "@canirun/models": "workspace:*",
    "@huggingface/transformers": "4.3.1",
    "@libsql/client": "0.18.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@zumer/snapdom": "3.3.4",
    "astro": "7.4.0",
    "comlink": "4.4.2",
    "pdfjs-dist": "6.4.299",
    "satori": "0.60.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}